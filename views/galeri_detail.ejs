<script type="module">
  import PhotoSwipeLightbox from 'https://unpkg.com/photoswipe@5.4.2/dist/photoswipe-lightbox.esm.js';
  import PhotoSwipe from 'https://unpkg.com/photoswipe@5.4.2/dist/photoswipe.esm.js';

  // --- FIX UTAMA: AUTO-DETECT WIDTH & HEIGHT SEBELUM LIGHTBOX DIBUKA ---
  const links = document.querySelectorAll('.insta-item');

  links.forEach(a => {
    const url = a.getAttribute('href');
    const img = new Image();

    img.onload = () => {
      a.setAttribute('data-pswp-width', img.width);
      a.setAttribute('data-pswp-height', img.height);
    };

    img.src = url;
  });

  // --- INIT PHOTOSWIPE ---
  const lightbox = new PhotoSwipeLightbox({
    gallery: '.insta-grid',
    children: 'a',
    pswpModule: PhotoSwipe,
    bgOpacity: 0.95,
    zoom: true,
    tapAction: 'close',
    doubleTapAction: 'zoom',
    padding: { top: 0, bottom: 0, left: 0, right: 0 }
  });

  lightbox.init();
</script>
