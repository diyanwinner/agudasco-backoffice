<main>
  <div class="container section">
    
    <div style="margin-bottom: 24px; border-bottom: 1px solid var(--border); padding-bottom: 16px;">
      <a href="/galeri" style="display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 14px; text-decoration: none; margin-bottom: 12px;">
        &larr; Kembali ke Galeri
      </a>
      <h1 style="margin: 0; font-size: 24px;"><%= album.title %></h1>
      <p class="muted" style="margin-top: 4px; font-size: 13px;">
        <%= new Date(album.event_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %> 
        • <%= photos.length %> Foto
      </p>
    </div>

    <% if (photos.length === 0) { %>
      <div class="card" style="padding: 40px; text-align: center;">
        <p class="muted">Album ini belum ada fotonya.</p>
      </div>
    <% } else { %>
      <div class="insta-grid">
        <% photos.forEach((photo, index) => { %>
          <a href="<%= photo.image_url %>" class="insta-item" data-caption="<%= photo.caption || '' %>">
            <img src="<%= photo.image_url %>" loading="lazy" alt="Dokumentasi">
          </a>
        <% }) %>
      </div>
    <% } %>

  </div>
</main>

<style>
  /* Layout Grid Kotak-Kotak (IG Style) */
  .insta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 Kolom di HP */
    gap: 3px; 
  }
  @media (min-width: 768px) {
    .insta-grid { grid-template-columns: repeat(4, 1fr); gap: 6px; }
  }
  @media (min-width: 1024px) {
    .insta-grid { grid-template-columns: repeat(5, 1fr); }
  }

  /* Thumbnail Kotak Sempurna */
  .insta-item {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #111;
    cursor: zoom-in;
    position: relative;
  }
  .insta-item img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Crop rapi jadi kotak */
    transition: transform 0.3s ease, filter 0.3s;
  }
  .insta-item:hover img {
    transform: scale(1.05); /* Efek zoom dikit pas hover */
    filter: brightness(1.1);
  }

  /* --- PENTING: FIX TAMPILAN LIGHTBOX BIAR GAK GEPENG --- */
  .pswp__img {
    object-fit: contain !important; /* Foto zoom menyesuaikan bentuk asli */
    width: auto !important;
    height: auto !important;
  }
</style>

<link rel="stylesheet" href="https://unpkg.com/photoswipe@5.4.2/dist/photoswipe.css">
<script type="module">
  import PhotoSwipeLightbox from 'https://unpkg.com/photoswipe@5.4.2/dist/photoswipe-lightbox.esm.js';
  import PhotoSwipe from 'https://unpkg.com/photoswipe@5.4.2/dist/photoswipe.esm.js';

  // 1. DETEKSI UKURAN ASLI FOTO OTOMATIS
  // Biar pas dibuka zoom-nya presisi sesuai bentuk aslinya
  const links = document.querySelectorAll('.insta-item');
  links.forEach((link) => {
    const img = new Image();
    img.src = link.href;
    
    // Pas gambar aslinya berhasil dimuat di background...
    img.onload = function() {
      // ...Kita kasih tau Lightbox ukuran aslinya berapa
      link.setAttribute('data-pswp-width', img.naturalWidth);
      link.setAttribute('data-pswp-height', img.naturalHeight);
    };
  });

  // 2. SETUP LIGHTBOX
  const lightbox = new PhotoSwipeLightbox({
    gallery: '.insta-grid',
    children: 'a',
    pswpModule: PhotoSwipe,
    
    // Fitur User Experience
    zoom: true,                 // Pinch to zoom
    imageClickAction: 'zoom',   // Klik foto = zoom/unzoom
    tapAction: 'zoom',          // Tap di HP = zoom
    doubleTapAction: 'zoom',    // Double tap = zoom
    bgOpacity: 0.95,            // Background gelap pekat biar fokus
    
    // Padding biar gak nabrak tepi layar HP
    padding: { top: 0, bottom: 0, left: 0, right: 0 } 
  });

  lightbox.init();
</script>
