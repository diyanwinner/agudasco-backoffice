<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Admin - AGUDASCO</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #111827; /* Dark Background */
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      color: #fff;
    }
    .login-card {
      background-color: #1f2937; /* Card Color */
      padding: 2.5rem;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      width: 100%;
      max-width: 380px;
      border: 1px solid #374151;
    }
    .brand {
      text-align: center;
      margin-bottom: 2rem;
    }
    .brand h1 {
      margin: 0;
      font-size: 1.8rem;
      color: #60a5fa; /* Aksen Biru */
      letter-spacing: 1px;
    }
    .brand p {
      margin: 5px 0 0;
      color: #9ca3af;
      font-size: 0.9rem;
    }
    .form-group {
      margin-bottom: 1.5rem;
    }
    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
      color: #d1d5db;
    }
    .form-group input {
      width: 100%;
      padding: 0.75rem;
      border-radius: 8px;
      border: 1px solid #4b5563;
      background-color: #374151;
      color: white;
      box-sizing: border-box; /* Biar gak melebar */
      outline: none;
      transition: border 0.3s;
    }
    .form-group input:focus {
      border-color: #60a5fa;
    }
    .btn-login {
      width: 100%;
      padding: 0.85rem;
      background-color: #2563eb;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.3s;
    }
    .btn-login:hover {
      background-color: #1d4ed8;
    }
    .alert {
      background-color: #7f1d1d;
      color: #fca5a5;
      padding: 0.75rem;
      border-radius: 6px;
      margin-bottom: 1.5rem;
      text-align: center;
      font-size: 0.9rem;
      border: 1px solid #991b1b;
    }
    .back-link {
      text-align: center;
      margin-top: 1.5rem;
    }
    .back-link a {
      color: #6b7280;
      text-decoration: none;
      font-size: 0.9rem;
    }
    .back-link a:hover { color: #9ca3af; }
  </style>
</head>
<body>

  <div class="login-card">
    <div class="brand">
      <h1>AGUDASCO</h1>
      <p>Administrator Access</p>
    </div>

    <% if (error) { %>
      <div class="alert">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" placeholder="Masukkan username" required autocomplete="off">
      </div>
      
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="Masukkan password" required>
      </div>

      <button type="submit" class="btn-login">Masuk Dashboard</button>
    </form>

    <div class="back-link">
      <a href="/">&larr; Kembali ke Website Utama</a>
    </div>
  </div>

</body>
</html>
