<style>
  /* CSS Khusus Dashboard */
  .admin-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }
  .admin-title { margin: 0; font-size: 1.8rem; color: #1f2937; }
  
  .btn-logout {
    background-color: #dc2626;
    color: white;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  .btn-logout:hover { background-color: #b91c1c; }

  /* Kartu Ulang Tahun Hari Ini */
  .birthday-today {
    border: 2px solid #f87171;
    background-color: #fef2f2;
  }
  .badge-today {
    background-color: #ef4444;
    color: white;
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 4px;
    vertical-align: middle;
    margin-left: 6px;
  }
</style>

<div class="admin-wrap">
  
  <div class="admin-head">
    <div>
      <h1 class="admin-title">Dashboard Admin</h1>
      <small style="color: #6b7280;">Selamat datang, Admin!</small>
    </div>
    <div style="display: flex; gap: 10px;">
      <a class="btn" href="/" target="_blank">Lihat Web</a>
      <a class="btn-logout" href="/logout">Logout</a>
    </div>
  </div>

  <% /* ===== BAGIAN 1: ULANG TAHUN ===== */ %>
  <% if (typeof upcomingBirthdays !== 'undefined' && upcomingBirthdays.length > 0) { %>
    <section class="section">
      <div class="section-head">
        <h2>🎂 Ulang Tahun 7 Hari ke Depan</h2>
      </div>
      <div class="grid cards">
        <% upcomingBirthdays.forEach(function(b){ 
             const d = b.birthdate ? new Date(b.birthdate) : null;
             const tgl = d ? d.toLocaleDateString('id-ID', { day: '2-digit', month: 'long' }) : '-';
        %>
          <div class="card <%= b.is_today ? 'birthday-today' : '' %>">
            <div class="pad">
              <h3 style="margin-bottom:6px">
                <%= b.name %>
                <% if (b.is_today) { %>
                  <span class="badge-today">HARI INI</span>
                <% } %>
              </h3>
              <p class="meta" style="margin-bottom:12px">📅 <%= tgl %></p>
              <a class="btn ghost" href="/admin/members/<%= b.id %>">Lihat Detail</a>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% /* ===== BAGIAN 2: MENU ADMIN LENGKAP ===== */ %>
  <section class="section">
    <div class="section-head">
      <h2>🚀 Menu Utama</h2>
    </div>

    <div class="grid cards">
      
      <div class="card">
        <div class="pad">
          <h3>👥 Anggota</h3>
          <p class="meta">Database data anggota utama.</p>
          <div style="display:flex; gap:8px;">
            <a class="btn" href="/admin/members">Kelola</a>
            <a class="btn ghost" href="/admin/members/new">+Baru</a>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="pad">
          <h3>👨‍👩‍👧‍👦 Keluarga</h3>
          <p class="meta">Data istri/suami & anak anggota.</p>
          <a class="btn" href="/admin/family">Buka Data Keluarga</a>
        </div>
      </div>

      <div class="card">
        <div class="pad">
          <h3>📸 Galeri</h3>
          <p class="meta">Album foto & dokumentasi.</p>
          <a class="btn" href="/admin/galeri">Buka Galeri</a>
        </div>
      </div>

      <div class="card">
        <div class="pad">
          <h3>📝 Artikel</h3>
          <p class="meta">Berita & blog organisasi.</p>
          <a class="btn" href="/admin/articles">Buka Artikel</a>
        </div>
      </div>

      <div class="card">
        <div class="pad">
          <h3>🖼️ Banner Depan</h3>
          <p class="meta">Slider gambar halaman home.</p>
          <a class="btn" href="/admin/banners">Atur Banner</a>
        </div>
      </div>
  </section>
</div>
