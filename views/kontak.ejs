<%
// Ambil nilai dari server (pastikan route kirim object 'contact' – boleh null/undefined)
const addr  = (contact && contact.address || '').trim();
const email = (contact && contact.email   || '').trim();
const phone = (contact && contact.phone   || '').trim();
%>

<section class="section">
  <h1>Kontak</h1>

  <div class="card" style="max-width:880px">
    <div class="pad">
      <h3>Alamat</h3>
      <p class="<%= addr ? '' : 'muted' %>"><%= addr || 'Belum diisi' %></p>

      <h3>Email</h3>
      <p class="<%= email ? '' : 'muted' %>">
        <% if (email) { %>
          <a href="mailto:<%= email %>"><%= email %></a>
        <% } else { %>
          Belum diisi
        <% } %>
      </p>

      <h3>Telepon/WA</h3>
      <p class="<%= phone ? '' : 'muted' %>">
        <% if (phone) { %>
          <a href="https://wa.me/<%= phone.replace(/[^0-9]/g,'') %>" target="_blank" rel="noopener"> <%= phone %> </a>
        <% } else { %>
          Belum diisi
        <% } %>
      </p>

      <% // Opsional: Socials, hanya tampil kalau ada %>
      <% const ig = (contact && contact.instagram || '').trim();
         const fb = (contact && contact.facebook || '').trim();
         const tw = (contact && contact.twitter  || '').trim();
         const map = (contact && contact.map_url  || '').trim();
      %>

      <% if (ig || fb || tw || map) { %>
        <hr/>
        <div class="grid" style="grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap:10px">
          <% if (ig) { %><div>Instagram: <a href="<%= ig %>" target="_blank" rel="noopener"><%= ig %></a></div><% } %>
          <% if (fb) { %><div>Facebook: <a href="<%= fb %>" target="_blank" rel="noopener"><%= fb %></a></div><% } %>
          <% if (tw) { %><div>X/Twitter: <a href="<%= tw %>" target="_blank" rel="noopener"><%= tw %></a></div><% } %>
          <% if (map) { %><div>Maps: <a href="<%= map %>" target="_blank" rel="noopener">Lihat peta</a></div><% } %>
        </div>
      <% } %>
    </div>
  </div>
</section>
