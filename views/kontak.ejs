<%
// Amanin object
const c = contact || {};
const safe = v => (v && String(v).trim()) ? v : null;
%>

<div class="container section">
  <h1>Kontak</h1>

  <div class="card" style="padding:16px">
    <h3 class="muted"><%= safe(c.org_name) || '—' %></h3>

    <h4>Alamat</h4>
    <p><%= safe(c.address) || 'Belum diisi' %></p>

    <h4>Email</h4>
    <p><%= safe(c.email) || 'Belum diisi' %></p>

    <h4>Telepon/WA</h4>
    <p>
      <% if (safe(c.phone)) { %><div>Telp: <%= c.phone %></div><% } %>
      <% if (safe(c.whatsapp)) { %><div>WA: <%= c.whatsapp %></div><% } %>
      <% if (!safe(c.phone) && !safe(c.whatsapp)) { %>Belum diisi<% } %>
    </p>

    <% if (safe(c.instagram) || safe(c.facebook) || safe(c.x_handle)) { %>
      <h4>Sosial</h4>
      <ul>
        <% if (safe(c.instagram)) { %><li>Instagram: <a href="<%= c.instagram %>" target="_blank" rel="noopener"><%= c.instagram %></a></li><% } %>
        <% if (safe(c.facebook)) { %><li>Facebook: <a href="<%= c.facebook %>" target="_blank" rel="noopener"><%= c.facebook %></a></li><% } %>
        <% if (safe(c.x_handle))  { %><li>X/Twitter: <a href="<%= c.x_handle.startsWith('http') ? c.x_handle : ('https://x.com/' + c.x_handle.replace('@','')) %>" target="_blank" rel="noopener"><%= c.x_handle %></a></li><% } %>
      </ul>
    <% } %>

    <% if (safe(c.maps_url)) { %>
      <div style="border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-top:12px">
        <iframe src="<%= c.maps_url %>" width="100%" height="320" style="border:0" loading="lazy"></iframe>
      </div>
    <% } %>
  </div>
</div>
