<%
// AMANIN DATA
const f = (typeof footerContact !== 'undefined' && footerContact) ? footerContact : {};
const ORG = f.org_name || 'AGUDASCO';
%>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
  <h4 class="footer-heading">Kontak</h4>

  <p>
    <% if (footerContact && footerContact.address) { %>
      <%= footerContact.address %>
    <% } else { %>
      Belum diisi
    <% } %>
  </p>

  <p>
    <% if (footerContact && footerContact.email) { %>
      <a href="mailto:<%= footerContact.email %>">
        <%= footerContact.email %>
      </a>
    <% } else { %>
      Belum diisi
    <% } %>
  </p>

  <p>
    <% if (footerContact && footerContact.phone) { %>
      <a href="https://wa.me/<%= footerContact.phone.replace(/^0/, '62') %>"
         target="_blank" rel="noopener">
        <%= footerContact.phone %>
      </a>
    <% } else { %>
      Belum diisi
    <% } %>
  </p>
</div>
</footer>
