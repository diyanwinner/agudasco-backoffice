<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <!-- KOL 1 – Tentang -->
      <div class="footer-col">
        <h4 class="footer-heading">Tentang</h4>
        <p>
          AGUDASCO adalah wadah organisasi yang bertujuan untuk
          membangun persaudaraan, kegiatan sosial, dan pengembangan komunitas.
        </p>
      </div>

      <!-- KOL 3 – Kontak -->
      <%
        const fc = (typeof footerContact !== 'undefined' && footerContact)
          ? footerContact
          : (typeof contact !== 'undefined' ? contact : {});
      %>
      <div class="footer-col">
        <h4 class="footer-heading">Kontak</h4>
        <p><%= (fc.address && fc.address.trim()) || 'Belum diisi' %></p>
        <p><%= (fc.email   && fc.email.trim())   || 'Belum diisi' %></p>
        <p><%= (fc.phone   && fc.phone.trim())   || 'Belum diisi' %></p>
      </div>

    </div>

    <div class="footer-bottom">
      <div>© 2025 AGUDASCO — All rights reserved.</div>
      <div class="muted">Dibangun dengan ❤️ untuk keluarga besar AGUDASCO.</div>
    </div>
  </div>
</footer>
