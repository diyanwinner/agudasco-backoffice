<%
// AMANIN DATA
const f = (typeof footerContact !== 'undefined' && footerContact) ? footerContact : {};
const ORG = f.org_name || 'AGUDASCO';
%>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h4 class="footer-heading"><%= ORG %></h4>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Kontak</h4>
        <% if (f.email)   { %><p>Email: <%= f.email %></p><% } %>
        <% if (f.address) { %><p>Alamat: <%= f.address %></p><% } %>
        <% if (!f.email && !f.address) { %><p>—</p><% } %>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Tautan</h4>
        <ul class="footer-links">
          <li><a href="/laporan">Laporan Keuangan</a></li>
          <li><a href="/adart">AD/ART</a></li>
          <li><a href="/kontak">Kontak</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>© <%= new Date().getFullYear() %> <%= ORG %></div>
    </div>
  </div>
</footer>
