<%
  const f = (typeof footerContact !== 'undefined' && footerContact) ? footerContact : {};
  const ORG = f.org_name || 'AGUDASCO';
%>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <!-- KOL 1 – Tentang -->
      <div class="footer-col">
        <h4 class="footer-heading">Tentang</h4>
        <p>
          AGUDASCO adalah wadah organisasi yang bertujuan untuk membangun persaudaraan,
          kegiatan sosial, dan pengembangan komunitas.
        </p>
      </div>

      <!-- KOL 2 – Navigasi -->
      <div class="footer-col">
        <h4 class="footer-heading">Navigasi</h4>
        <ul class="footer-links">
          <li><a href="/">Beranda</a></li>
          <li><a href="/artikel">Artikel</a></li>
          <li><a href="/laporan">Laporan</a></li>
          <li><a href="/anggota">Anggota</a></li>
          <li><a href="/kontak">Kontak</a></li>
        </ul>
      </div>

      <!-- KOL 3 – Kontak -->
      <div class="footer-col">
        <h4 class="footer-heading">Kontak</h4>

        <p>
          <% if (footerContact && footerContact.address) { %>
            <%= footerContact.address %>
          <% } else { %>
            Belum diisi
          <% } %>
        </p>

        <p>
          <% if (footerContact && footerContact.email) { %>
            <a href="mailto:<%= footerContact.email %>"><%= footerContact.email %></a>
          <% } else { %>
            Belum diisi
          <% } %>
        </p>

        <p>
          <% if (footerContact && footerContact.phone) { %>
            <a href="https://wa.me/<%= footerContact.phone.replace(/^0/, '62') %>" target="_blank" rel="noopener">
              <%= footerContact.phone %>
            </a>
          <% } else { %>
            Belum diisi
          <% } %>
        </p>
      </div>

    </div>

    <div class="footer-bottom">
      <p>© <%= new Date().getFullYear() %> <%= ORG %> — All rights reserved.</p>
    </div>
  </div>
</footer>
