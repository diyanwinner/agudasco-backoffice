<%
  const c = (typeof footerContact !== 'undefined' && footerContact) ? footerContact : {};
  const safe = v => (v && String(v).trim()) ? String(v).trim() : null;

  const org   = safe(c.org_name)  || 'AGUDASCO';
  const email = safe(c.email);
  const addr  = safe(c.address);
%>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <div class="footer-col">
        <div class="footer-heading"><%= org %></div>
        <p>© <%= new Date().getFullYear() %> <%= org %></p>
      </div>

      <div class="footer-col">
        <div class="footer-heading">Kontak</div>
        <p>Email: <%= email || '—' %></p>
        <p>Alamat: <%= addr  || '—' %></p>
      </div>

      <div class="footer-col">
        <div class="footer-heading">Tautan</div>
        <ul class="footer-links">
          <li><a href="/laporan">Laporan Keuangan</a></li>
          <li><a href="/adart">AD/ART</a></li>
          <li><a href="/kontak">Kontak</a></li>
        </ul>
      </div>

    </div>
    <div class="footer-bottom">
      <span>© <%= new Date().getFullYear() %> <%= org %></span>
      <span class="muted">Dibangun dengan ♥</span>
    </div>
  </div>
</footer>
