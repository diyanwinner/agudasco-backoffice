<%
const f = footerContact || {}; %>
<h4 class="footer-heading">Kontak</h4>
<% if (f.email)   { %><p>Email: <%= f.email %></p><% } %>
<% if (f.address) { %><p>Alamat: <%= f.address %></p><% } %>
%>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <div class="footer-col">
        <div class="footer-heading"><%= org %></div>
        <p>© <%= new Date().getFullYear() %> <%= org %></p>
      </div>

      <div class="footer-col">
        <div class="footer-heading">Kontak</div>
        <p>Email: <%= email || '—' %></p>
        <p>Alamat: <%= addr  || '—' %></p>
      </div>

      <div class="footer-col">
        <div class="footer-heading">Tautan</div>
        <ul class="footer-links">
          <li><a href="/laporan">Laporan Keuangan</a></li>
          <li><a href="/adart">AD/ART</a></li>
          <li><a href="/kontak">Kontak</a></li>
        </ul>
      </div>

    </div>
    <div class="footer-bottom">
      <span>© <%= new Date().getFullYear() %> <%= org %></span>
      <span class="muted">Dibangun dengan ♥</span>
    </div>
  </div>
</footer>
