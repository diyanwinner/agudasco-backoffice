<%
  const f = (typeof footerContact !== 'undefined' && footerContact) ? footerContact : {};
  const ORG = f.org_name || 'AGUDASCO';
%>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <!-- KOL 1 – Tentang -->
      <div class="footer-col">
        <h4 class="footer-heading">Tentang</h4>
        <p>
          AGUDASCO adalah wadah organisasi yang bertujuan untuk membangun persaudaraan,
          kegiatan sosial, dan pengembangan komunitas.
        </p>
      </div>

      <!-- KOL 2 – Navigasi -->
      <div class="footer-col">
        <h4 class="footer-heading">Navigasi</h4>
        <ul class="footer-links">
          <li><a href="/">Beranda</a></li>
          <li><a href="/artikel">Artikel</a></li>
          <li><a href="/laporan">Laporan</a></li>
          <li><a href="/anggota">Anggota</a></li>
          <li><a href="/kontak">Kontak</a></li>
        </ul>
      </div>

      <!-- KOL 3 – Kontak -->
      <div class="footer-col">
        <h4 class="footer-heading">Kontak</h4>

        <%
        // Ambil data kontak dari mana saja yang tersedia:
        // 1. footerContact dari server.js (res.locals)
        // 2. contact (dipakai di halaman /kontak)
        const src =
          (typeof footerContact !== 'undefined' && footerContact) ||
          (typeof contact !== 'undefined' && contact) ||
          {};

        const safe = v => (v && String(v).trim()) ? String(v).trim() : null;

        const address = safe(src.address || src.alamat);
        const email   = safe(src.email   || src.org_email || src.contact_email);
        const phone   = safe(src.phone   || src.telepon   || src.telepon_wa);
        const wa      = safe(src.whatsapp);
        %>

        <p><%= address || 'Belum diisi' %></p>
        <p><%= email   || 'Belum diisi' %></p>
        <p>
          <% if (phone) { %>
            Telp: <%= phone %><br>
          <% } %>
          <% if (wa) { %>
            WA: <%= wa %>
          <% } %>
          <% if (!phone && !wa) { %>
            Belum diisi
          <% } %>
        </p>
      </div>
  </div>
</footer>
