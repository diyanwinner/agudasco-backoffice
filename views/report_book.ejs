<%- include('layout-top', { title: 'Laporan Keuangan 2025 (Flipbook)', active: 'laporan' }) %>

<main class="section">
  <header class="section-head">
    <h1>Laporan Keuangan — Mode Flipbook</h1>
    <div class="muted">Gunakan tampilan flipbook untuk membaca laporan keuangan tahun 2025 secara nyaman.</div>
  </header>

  <div class="book-wrap form-dark">
    <div id="flipbook" class="flipbook-container">
      <!-- Fallback jika JS mati -->
      <iframe
        src="/docs/laporankeuangantahun2025.pdf#view=FitH"
        title="Laporan Keuangan 2025"
        style="width:100%;height:100%;border:0;"
      ></iframe>
    </div>
  </div>
</main>

<script>
  // Inisialisasi flipbook simpel dengan PDF.js / turn.js kalau sudah di-load di layout
  (function () {
    const el = document.getElementById('flipbook');
    if (!el) return;

    // Kalau kamu nanti punya inisialisasi khusus (kayak di AD/ART),
    // bisa dipanggil di sini. Untuk sekarang kita biarkan iframe-nya yang kerja.
    //
    // Contoh (kalau ada helper global):
    // if (window.initFlipbook) {
    //   window.initFlipbook(el, '/docs/laporankeuangantahun2025.pdf');
    // }

    // Kita kasih info kecil buat user mobile supaya mereka zoom sendiri
    el.setAttribute('aria-label', 'Laporan keuangan 2025, tampilan flipbook. Untuk membaca dengan super tajam, gunakan Mode Zoom.');
  })();
</script>

<style>
  /* Dark skin & gambar fit */
  .form-dark .page { background:#0f172a; }
  #flipbook .page img{
    width:100%;
    height:100%;
    object-fit:contain;
    image-rendering:auto;
  }

  @media (max-width:576px){
    .container{ padding-left:.5rem; padding-right:.5rem; }
    #flipbook{ height:74vh !important; }
  }
</style>

<%- include('layout-bottom') %>
