<main>
  <div class="container section">
    
    <header class="section-head">
      <div class="title-wrapper">
        <h1>Galeri</h1>
        <% if (albums && albums.length) { %>
          <span class="count-badge"><%= albums.length %> Album</span>
        <% } %>
      </div>
      <div class="muted">Dokumentasi kegiatan dan momen kebersamaan keluarga besar AGUDASCO.</div>
    </header>

    <% if (!albums || albums.length === 0) { %>
      <div class="card" style="padding: 40px; text-align: center;">
        <p class="muted">Belum ada album galeri yang diupload.</p>
      </div>
    <% } else { %>

      <div class="grid cards">
        <% albums.forEach(album => { %>
          <a href="/galeri/<%= album.id %>" class="card album-card-public" style="text-decoration: none; color: inherit;">
            
            <div style="height: 200px; overflow: hidden; position: relative;">
              <img src="<%= album.cover_image %>" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;">
              
              <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 30px 14px 14px; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
                <span style="font-size: 12px; color: rgba(255,255,255,0.8); display: flex; align-items: center; gap: 6px;">
                  <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                  Lihat Album
                </span>
              </div>
            </div>

            <div class="pad">
              <div class="meta" style="margin-bottom: 6px;">
                <%= new Date(album.event_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
              </div>
              <h3 style="font-size: 18px; margin: 0; line-height: 1.3;"><%= album.title %></h3>
              <% if (album.description) { %>
                <p class="muted" style="font-size: 13px; margin-top: 6px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= album.description %>
                </p>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>

    <% } %>
  </div>
</main>

<style>
  /* Efek Hover biar gambar nge-zoom dikit */
  .album-card-public:hover img {
    transform: scale(1.05);
  }
</style>
