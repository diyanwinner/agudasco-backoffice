<h2>Laporan Keuangan</h2>
<div class="grid cards">
  <% (reports||[]).forEach(r=>{ %>
    <div class="card">
      <img src="<%= r.cover||'https://via.placeholder.com/640x360?text=Laporan' %>" alt="<%= r.title %>"/>
      <div class="pad">
        <h3><a href="/laporan/<%= r.id %>"><%= r.title %></a></h3>
        <p class="meta"><%= new Date(r.created_at).toLocaleDateString('id-ID') %></p>
        <a class="btn" href="/laporan/<%= r.id %>">Detail</a>
      </div>
    </div>
  <% }) %>
</div>

<%- include('./layout-bottom', { active: 'beranda' }) %>
