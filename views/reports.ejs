<h1 style="margin:0 0 12px;">Laporan Keuangan</h1>

<style>
  .grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap:16px; }
  .card { background:#0b1424; border:1px solid #1f2937; border-radius:12px; overflow:hidden; }
  .cover { width:100%; height:160px; object-fit:cover; background:#0c1424; }
  .body { padding:12px; }
  .title { color:#e5e7eb; font-weight:700; margin:0 0 8px; }
  .btn { display:inline-block; padding:8px 12px; border-radius:8px; font-weight:700; text-decoration:none; border:0; cursor:pointer; }
  .btn.primary { background:#22c55e; color:#032010; }
  .btn.secondary { background:#334155; color:#e5e7eb; }
  .row { display:flex; gap:8px; }
</style>

<div class="grid">
  <% reports.forEach(r => { %>
    <div class="card">
      <% if (r.cover) { %>
        <img src="<%= r.cover %>" class="cover" alt="Cover <%= r.title %>">
      <% } %>
      <div class="body">
        <div class="title"><%= r.title %></div>
        <div class="row">
          <a class="btn secondary" href="/laporan/<%= r.id %>">Lihat</a>
          <% if (r.pdf_url) { %>
            <a class="btn primary" href="<%= r.pdf_url %>" target="_blank" rel="noopener">Download PDF</a>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
</div>
