<% layout('layout') %>

<!-- SLIDER -->
<% if (banners && banners.length) { %>
  <section class="hero card">
    <div id="heroSlider" class="tns-carousel" style="aspect-ratio:16/9">
      <% banners.forEach(b => { %>
        <div>
          <img src="<%= b.image %>" alt="banner" style="width:100%;height:100%;object-fit:cover">
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<h3 class="section-title">Berita & Kegiatan Terbaru</h3>
<div class="cards">
  <% (arts || []).forEach(a => { %>
    <a class="card" href="/article/<%= a.id %>">
      <% if (a.image) { %>
        <img src="<%= a.image %>" alt="<%= a.title %>" style="width:100%;height:160px;object-fit:cover;border-radius:8px;margin-bottom:8px">
      <% } %>
      <h3 class="card-title"><%= a.title %></h3>
      <div class="muted"><%= new Date(a.created_at).toLocaleString() %></div>
      <div class="card-snippet"><%- (a.content || '').slice(0,150) %>…</div>
    </a>
  <% }) %>
  <% if (!(arts && arts.length)) { %>
    <div class="muted">Belum ada artikel dipublikasi.</div>
  <% } %>
</div>

<script>
  (function(){
    const el = document.getElementById('heroSlider');
    if (!el || !window.tns) return;
    if (el.dataset.inited === '1') return;
    tns({
      container: el,
      items: 1,
      slideBy: 1,
      autoplay: true,
      autoplayTimeout: 4500,
      autoplayButtonOutput: false,
      controls: true,
      controlsText: ['‹','›'],
      nav: true,
      mouseDrag: true,
      loop: true,
      speed: 500
    });
    el.dataset.inited = '1';
  })();
</script>
