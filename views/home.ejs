<!-- SLIDER / HERO -->
<section class="hero">
  <% if (banners && banners.length) { %>
    <div class="hero__track">
      <% banners.forEach(b => { %>
        <div class="hero__slide">
          <img src="<%= b.image %>" alt="Banner" class="hero__img">
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card"><em>Tidak ada banner.</em></div>
  <% } %>
</section>

<!-- ARTIKEL -->
<section class="container">
  <h2 class="section-title">Berita & Kegiatan Terbaru</h2>
  <% if (arts && arts.length) { %>
    <div class="cards">
      <% arts.forEach(a => { %>
        <a class="card" href="/article/<%= a.id %>">
          <% if (a.image) { %>
            <img src="<%= a.image %>" alt="<%= a.title %>" class="card__thumb">
          <% } %>
          <h3 class="card__title"><%= a.title %></h3>
          <div class="muted"><%= new Date(a.created_at).toLocaleString() %></div>
          <p class="card__snippet"><%= (a.content || '').slice(0, 160) %>…</p>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card"><em>Belum ada artikel dipublikasi.</em></div>
  <% } %>
</section>
