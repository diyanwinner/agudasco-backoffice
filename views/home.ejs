<section class="hero">
  <h1 class="hero-title">Selamat datang di AGUDASCO</h1>

  <!-- SLIDER -->
  <div class="banner-wrapper">
    <div class="banner-track" style="--count:<%= (banners||[]).length %>;">
      <% (banners || []).forEach((b)=> { %>
        <div class="banner-slide">
          <img src="<%= b.image %>" alt="Banner">
        </div>
      <% }) %>
      <!-- duplikasi untuk looping mulus -->
      <% (banners || []).forEach((b)=> { %>
        <div class="banner-slide clone">
          <img src="<%= b.image %>" alt="Banner">
        </div>
      <% }) %>
    </div>

    <!-- optional nav -->
    <button class="nav prev" aria-label="Sebelumnya">‹</button>
    <button class="nav next" aria-label="Berikutnya">›</button>
  </div>

  <p class="hero-caption">Kabar terbaru dan kegiatan terkini.</p>
</section>
