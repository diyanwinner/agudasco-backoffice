<h1 class="sr-only">AGUDASCO</h1>

<!-- HERO / SLIDER -->
<section class="hero">
  <div class="hero__slider" id="heroSlider">
    <div class="hero__slide">
      <img
        src="https://res.cloudinary.com/dsyo0e3fu/image/upload/v1759492423/agudasco/1759492421911_WhatsApp_Image_2025-10-01_at_11.06.57_170c5fc9.jpg.jpg"
        alt="Banner 1 AGUDASCO" loading="eager">
      <div class="hero__overlay">
        <h2>AGUDASCO</h2>
        <p>Organisasi yang tumbuh bareng, berkarya bareng.</p>
      </div>
    </div>
    <div class="hero__slide">
      <img
        src="https://res.cloudinary.com/dsyo0e3fu/image/upload/v1759492436/agudasco/1759492434470_WhatsApp_Image_2025-09-25_at_16.55.36_38f341d2.jpg.jpg"
        alt="Banner 2 AGUDASCO" loading="lazy">
      <div class="hero__overlay">
        <h2>Kegiatan & Publikasi</h2>
        <p>Dokumentasi acara & cerita dari lapangan.</p>
      </div>
    </div>
  </div>
</section>

<!-- LIST ARTIKEL -->
<section id="berita">
  <h3 class="section-title">Berita & Kegiatan Terbaru</h3>
  <div class="cards">
    <% if (arts && arts.length) { %>
      <% arts.forEach(a => { %>
        <a class="card" href="/article/<%= a.slug %>">
          <h3 class="card-title"><%= a.title %></h3>
          <div class="card-snippet"><%= (a.content || "").slice(0,120) %>…</div>
        </a>
      <% }) %>
    <% } else { %>
      <div class="muted">Belum ada artikel dipublikasi.</div>
    <% } %>
  </div>
</section>
