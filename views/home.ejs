<!-- SLIDER -->
<% if (banners && banners.length) { %>
  <section class="hero">
    <div class="hero__slider" id="heroSlider">
      <% banners.forEach(b => { %>
        <div class="hero__slide">
          <img src="<%= b.image %>" alt="Banner AGUDASCO">
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<section class="container">
  <h3 class="section-title">Berita & Kegiatan Terbaru</h3>
  <div class="cards">
    <% if (arts.length) { %>
      <% arts.forEach(a => { %>
        <a class="card" href="/article/<%= a.id %>">
          <h3><%= a.title %></h3>
          <div class="muted"><%= new Date(a.created_at).toLocaleString() %></div>
          <% if (a.image) { %>
            <img src="<%= a.image %>" alt="<%= a.title %>" style="width:100%; border-radius:8px;">
          <% } %>
          <div><%- (a.content || '').slice(0,180) %>…</div>
        </a>
      <% }) %>
    <% } else { %>
      <div class="muted">Belum ada artikel dipublikasi.</div>
    <% } %>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const el = document.getElementById('heroSlider');
  if (!el || !window.tns) return;
  tns({
    container: el,
    items: 1,
    autoplay: true,
    autoplayTimeout: 4000,
    controls: true,
    controlsText: ['‹','›'],
    nav: true,
    mouseDrag: true,
    loop: true,
    speed: 500
  });
});
</script>
