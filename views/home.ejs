<section class="hero">
  <h1 class="hero-title">Selamat datang di AGUDASCO</h1>

  <!-- SLIDER: auto jalan kiri, pause saat hover -->
  <div class="banner-wrapper">
    <div class="banner-track">
      <% (banners || []).forEach(b => { %>
        <div class="banner-slide"><img src="<%= b.image %>" alt="Banner"></div>
      <% }) %>
      <% (banners || []).forEach(b => { %> <!-- duplikasi buat loop mulus -->
        <div class="banner-slide"><img src="<%= b.image %>" alt="Banner"></div>
      <% }) %>
    </div>

    <!-- tombol opsional -->
    <button class="nav prev" aria-label="Sebelumnya">‹</button>
    <button class="nav next" aria-label="Berikutnya">›</button>
  </div>

  <p class="hero-caption">Kabar terbaru dan kegiatan terkini.</p>
</section>

<script>
(function(){
  const wrap  = document.querySelector('.banner-wrapper');
  const track = wrap?.querySelector('.banner-track');
  if(!track) return;

  const slides = track.querySelectorAll('.banner-slide');
  const realCount = slides.length / 2;       // karena diduplikasi
  let index = 0;
  const INTERVAL = 4000;

  const apply = () => { track.style.transform = `translateX(-${index * 100}%)`; };

  function jump(to){
    const old = track.style.transition;
    track.style.transition = 'none';
    index = to; apply();
    track.offsetHeight;                       // reflow
    track.style.transition = old || 'transform .55s ease-in-out';
  }
  function next(){
    index++; apply();
    if(index === realCount){
      track.addEventListener('transitionend', () => jump(0), { once:true });
    }
  }
  function prev(){
    index = (index - 1 + realCount) % realCount;
    apply();
  }

  const btnPrev = wrap.querySelector('.prev');
  const btnNext = wrap.querySelector('.next');
  btnPrev?.addEventListener('click', prev);
  btnNext?.addEventListener('click', next);

  jump(0);
  let timer = setInterval(next, INTERVAL);
  wrap.addEventListener('mouseenter', () => clearInterval(timer));
  wrap.addEventListener('mouseleave', () => timer = setInterval(next, INTERVAL));
})();
</script>

<!-- ARTIKEL TERBARU -->
<section class="section">
  <div class="section-head">
    <h2>Artikel Terbaru</h2>
    <a class="link-more" href="/artikel">Lihat semua →</a>
  </div>

  <div class="grid cards">
    <% (arts || []).slice(0,6).forEach(a => { %>
      <article class="card">
        <img src="<%= a.image || 'https://via.placeholder.com/640x360?text=Artikel' %>" alt="<%= a.title %>">
        <div class="pad">
          <h3><a href="/artikel/<%= a.id %>"><%= a.title %></a></h3>
          <p class="meta"><%= new Date(a.created_at).toLocaleDateString('id-ID') %></p>
          <a class="btn" href="/artikel/<%= a.id %>">Baca</a>
        </div>
      </article>
    <% }) %>
    <% if(!(arts && arts.length)){ %>
      <p class="muted">Belum ada artikel.</p>
    <% } %>
  </div>
</section>

<%- include('./layout-bottom', { active: 'beranda' }) %>
