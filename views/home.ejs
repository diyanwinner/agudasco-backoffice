<script src="https://unpkg.com/aos@next/dist/aos.js"></script>
<script>
  // 1. Inisialisasi Animasi AOS
  AOS.init({
    offset: 100,      // Jarak trigger animasi (px)
    duration: 800,    // Durasi animasi (ms)
    easing: 'ease-out-cubic',
    once: true,       // Animasi cuma sekali biar ga pusing pas scroll bolak balik
  });

  // 2. Script Slider (Yang lama tetap dipertahankan)
  (function(){
    const wrap  = document.querySelector('.banner-wrapper');
    const track = wrap?.querySelector('.banner-track');
    if(!track) return;
    const slides = track.querySelectorAll('.banner-slide');
    const realCount = slides.length / 2; 
    let index = 0;
    const INTERVAL = 5000; 
    const apply = () => { track.style.transform = `translateX(-${index * 100}%)`; };
    function jump(to){
      const old = track.style.transition;
      track.style.transition = 'none';
      index = to; apply();
      track.offsetHeight; 
      track.style.transition = old || 'transform 0.8s cubic-bezier(0.25, 1, 0.5, 1)';
    }
    function next(){
      index++;
      apply();
      if(index === realCount){
        track.addEventListener('transitionend', () => jump(0), { once:true });
      }
    }
    jump(0);
    let timer = setInterval(next, INTERVAL);
    wrap.addEventListener('mouseenter', () => clearInterval(timer));
    wrap.addEventListener('mouseleave', () => timer = setInterval(next, INTERVAL));
  })();
</script>
