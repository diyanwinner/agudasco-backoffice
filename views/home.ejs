<link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />

<style>
  /* --- HERO SECTION: SPLIT SCREEN (Floating Card Style) --- */
  .hero-modern {
    width: 100vw;
    position: relative;
    left: 50%; right: 50%;
    margin-left: -50vw; margin-right: -50vw;
    
    min-height: 90vh; 
    background: #020617; 
    
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: -70px; /* Nembus navbar */
    padding-top: 70px;
    
    padding-right: 5vw; 
    padding-left: 0;
  }

  /* --- KOLOM KIRI (TEKS) --- */
  .hero-text-side {
    flex: 1; 
    max-width: 550px;
    padding: 3rem 4rem 3rem 6rem;
    z-index: 2;
    color: white;
    /* Animasi default dihapus, diganti AOS */
  }

  /* --- KOLOM KANAN (FOTO PENGURUS) --- */
  .hero-image-side {
    flex: 1.4; 
    height: 75vh; 
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    border: 2px solid rgba(255, 255, 255, 0.1);
    background: #000;
  }

  .banner-track-modern { display: flex; height: 100%; width: 100%; }
  
  .banner-slide-modern {
    min-width: 100%; height: 100%; position: relative;
  }
  
  .banner-slide-modern img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center; 
  }

  /* TIPOGRAFI KEREN */
  .hero-label {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background: rgba(14, 165, 233, 0.1);
    color: #38bdf8;
    border-radius: 50px;
    font-size: 0.8rem; font-weight: 700;
    margin-bottom: 1.5rem; letter-spacing: 1.5px;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .hero-title-modern {
    font-size: clamp(2.5rem, 4.5vw, 4.5rem); 
    font-weight: 800; line-height: 1.1;
    margin-bottom: 1.5rem; color: #ffffff;
  }
  
  .hero-caption-modern {
    font-size: 1.15rem; color: #94a3b8;
    margin-bottom: 3rem; line-height: 1.8; max-width: 90%;
  }
  
  .btn-hero-modern {
    display: inline-block; padding: 1rem 3rem; 
    background: #2563eb; color: white;
    font-size: 1rem; font-weight: 700; text-transform: uppercase; text-decoration: none;
    border-radius: 50px; transition: all 0.3s ease;
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
  }
  .btn-hero-modern:hover {
    background: #1d4ed8; 
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(37, 99, 235, 0.6);
  }

  /* --- RESPONSIF --- */
  @media (max-width: 992px) {
    .hero-modern { 
      flex-direction: column-reverse; /* Foto di ATAS */
      height: auto;
      padding: 90px 20px 40px; 
    }
    .hero-image-side {
      width: 100%; height: 45vh; flex: none;
      border-radius: 20px; margin-bottom: 2rem;
    }
    .hero-text-side {
      width: 100%; padding: 0; text-align: center;
    }
    .hero-label { margin: 0 auto 1.5rem; }
    .hero-caption-modern { margin-left: auto; margin-right: auto; }
  }

  /* --- STYLE SECTION LAINNYA --- */
  .section-modern { padding: 6rem 20px; max-width: 1200px; margin: 0 auto; overflow: hidden; } /* Overflow hidden biar animasi ga bikin scroll horizontal */
  
  .section-head-center { text-align: center; margin-bottom: 4rem; }
  .section-head-center h2 { font-size: 2.5rem; font-weight: 800; color: #fff; margin-bottom: 1rem; display: inline-block; position: relative; }
  .section-head-center h2::after { content: ''; display: block; width: 60px; height: 4px; background: #2563eb; margin: 15px auto 0; border-radius: 2px; }
  .section-head-center p { color: #94a3b8; max-width: 600px; margin: 0 auto; font-size: 1.1rem; }

  /* ABOUT */
  .about-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .about-img-box { position: relative; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5); transform: rotate(-2deg); transition: transform 0.3s; }
  .about-img-box:hover { transform: rotate(0deg) scale(1.02); }
  .about-img-box img { width: 100%; display: block; }
  .about-text h3 { font-size: 2rem; font-weight: 700; color: #fff; margin-bottom: 1.5rem; }
  .about-text p { color: #cbd5e1; line-height: 1.8; margin-bottom: 1.5rem; font-size: 1.1rem; }
  .check-list { list-style: none; padding: 0; margin-bottom: 2rem; }
  .check-list li { position: relative; padding-left: 35px; margin-bottom: 12px; color: #cbd5e1; font-size: 1.05rem; }
  .check-list li::before { content: '✔'; position: absolute; left: 0; top: 2px; color: #2563eb; font-weight: bold; font-size: 1.2rem; }

  /* CARD STYLE */
  .grid.cards-modern { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2.5rem; }
  .card-modern { background: #1e293b; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: transform 0.3s ease; text-decoration: none; color: white; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; }
  .card-modern:hover { transform: translateY(-10px); box-shadow: 0 25px 30px -5px rgba(0, 0, 0, 0.4); border-color: rgba(37, 99, 235, 0.5); }
  .card-image-wrap { height: 220px; overflow: hidden; }
  .card-modern img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1); }
  .card-modern:hover img { transform: scale(1.1); }
  .card-pad-modern { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; }
  .card-meta-modern { color: #94a3b8; font-size: 0.85rem; margin-bottom: 0.8rem; display: flex; align-items: center; gap: 6px; }
  .card-title-modern { font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; line-height: 1.4; color: #f8fafc; }
  .read-more-text { margin-top: auto; color: #38bdf8; font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; gap: 5px; }
  
  /* CONTACT */
  .contact-bg { background: #0f172a; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; padding: 6rem 0; margin-top: 4rem; }
  .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .contact-card { background: #1e293b; padding: 2.5rem 2rem; border-radius: 24px; text-align: center; border: 1px solid rgba(255,255,255,0.05); transition: 0.4s; position: relative; overflow: hidden; }
  .contact-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: #2563eb; transform: scaleX(0); transition: 0.4s; transform-origin: left; }
  .contact-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.3); }
  .contact-card:hover::before { transform: scaleX(1); }
  
  .icon-box { width: 70px; height: 70px; background: rgba(37, 99, 235, 0.1); color: #2563eb; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin: 0 auto 1.5rem; transition: 0.4s; }
  .contact-card:hover .icon-box { background: #2563eb; color: white; transform: rotateY(180deg); }
  
  .contact-card h4 { color: white; margin-bottom: 0.8rem; font-size: 1.3rem; font-weight: 700; }
  .contact-card p { color: #94a3b8; font-size: 1rem; margin-bottom: 1.5rem; line-height: 1.6; }
  .btn-contact-small { display: inline-block; padding: 0.6rem 1.5rem; border: 1px solid #334155; border-radius: 50px; color: #cbd5e1; text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: 0.3s; }
  .btn-contact-small:hover { background: #2563eb; border-color: #2563eb; color: white; }
  
  @media (max-width: 768px) { .about-wrap { grid-template-columns: 1fr; } }
</style>

