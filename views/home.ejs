<section class="hero">
  <h1 class="hero-title">Selamat datang di AGUDASCO</h1>

  <!-- SLIDER -->
  <div class="banner-wrapper">
    <div class="banner-track" style="--count:<%= (banners||[]).length %>;">
      <% (banners || []).forEach((b)=> { %>
        <div class="banner-slide">
          <img src="<%= b.image %>" alt="Banner">
        </div>
      <% }) %>
      <!-- duplikasi untuk looping mulus -->
      <% (banners || []).forEach((b)=> { %>
        <div class="banner-slide clone">
          <img src="<%= b.image %>" alt="Banner">
        </div>
      <% }) %>
    </div>

    <!-- optional nav -->
    <button class="nav prev" aria-label="Sebelumnya">‹</button>
    <button class="nav next" aria-label="Berikutnya">›</button>
  </div>

  <p class="hero-caption">Kabar terbaru dan kegiatan terkini.</p>
</section>
<script>
(function(){
  const track = document.querySelector('.banner-track');
  if(!track) return;

  const slides = track.querySelectorAll('.banner-slide');
  const realCount = slides.length / 2; // karena kita gandakan untuk loop
  let index = 0;
  const INTERVAL = 4000;  // jeda antar slide

  // terapkan posisi berdasar index (tiap slide = 100% lebar)
  const apply = () => track.style.transform = `translateX(-${index * 100}%)`;

  // lompat instan (tanpa animasi) ke index tertentu
  function jump(to){
    const old = track.style.transition;
    track.style.transition = 'none';
    index = to;
    apply();
    // force reflow agar transition berikutnya aktif lagi
    track.offsetHeight; 
    track.style.transition = old || 'transform .55s ease-in-out';
  }

  // gerak maju 1 slide (kiri terus)
  function next(){
    index++;
    apply();
    // jika sudah mencapai duplikasi terakhir, setelah transisi selesai
    // kita lompat instan balik ke index 0 supaya loop mulus
    if(index === realCount){
      track.addEventListener('transitionend', () => jump(0), { once:true });
    }
  }

  // tombol opsional
  const p = document.querySelector('.banner-wrapper .prev');
  const n = document.querySelector('.banner-wrapper .next');
  p && p.addEventListener('click', ()=>{ jump( (index-1+realCount)%realCount ); });
  n && n.addEventListener('click', ()=>{ next(); });

  // init posisi & autoplay satu arah
  jump(0);
  let timer = setInterval(next, INTERVAL);
  // pause saat hover (opsional)
  track.closest('.banner-wrapper').addEventListener('mouseenter', ()=>clearInterval(timer));
  track.closest('.banner-wrapper').addEventListener('mouseleave', ()=>timer = setInterval(next, INTERVAL));
})();
</script>

<!-- ARTIKEL TERBARU -->
<section class="section">
  <div class="section-head">
    <h2>Artikel Terbaru</h2>
    <a class="link-more" href="/artikel">Lihat semua →</a>
  </div>

  <div class="grid cards">
    <% (arts||[]).forEach(a => { %>
      <article class="card">
        <img src="<%= a.image || 'https://via.placeholder.com/640x360?text=Artikel' %>" alt="<%= a.title %>">
        <div class="pad">
          <h3><a href="/artikel/<%= a.id %>"><%= a.title %></a></h3>
          <p class="meta"><%= new Date(a.created_at).toLocaleDateString('id-ID') %></p>
          <a class="btn" href="/artikel/<%= a.id %>">Baca</a>
        </div>
      </article>
    <% }) %>
    <% if (!(arts||[]).length) { %>
      <p class="muted">Belum ada artikel.</p>
    <% } %>
  </div>
</section>
