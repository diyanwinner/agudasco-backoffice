<!-- SLIDER -->
<% if (banners && banners.length) { %>
  <section class="hero">
    <div class="hero__slider" id="heroSlider">
      <% banners.forEach(b => { %>
        <div class="hero__slide">
          <img src="<%= b.url %>" alt="<%= b.title %>" loading="lazy">
          <div class="hero__overlay">
            <h2><%= b.title %></h2>
            <% if (b.caption) { %>
              <p><%= b.caption %></p>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<!-- GRID ARTIKEL -->
<section class="container">
  <h3 class="section-title">Berita & Kegiatan Terbaru</h3>
  <div class="cards">
    <% if (arts && arts.length) { %>
      <% arts.forEach(a => { %>
        <a class="card" href="/article/<%= a.slug %>">
          <h3><%= a.title %></h3>
          <div class="muted"><%= new Date(a.created_at).toLocaleString() %></div>
          <div><%- (a.content || '').slice(0,180) %>…</div>
        </a>
      <% }) %>
    <% } else { %>
      <div class="muted">Belum ada artikel dipublikasi.</div>
    <% } %>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const el = document.getElementById('heroSlider');
    if (!el || !window.tns) return;
    if (el.dataset.inited === '1') return;

    tns({
      container: el,
      items: 1,
      slideBy: 1,
      autoplay: true,
      autoplayTimeout: 4500,
      autoplayButtonOutput: false,
      controls: true,
      controlsText: ['‹','›'],
      nav: true,
      navPosition: 'bottom',
      mouseDrag: true,
      loop: true,
      speed: 500
    });

    el.dataset.inited = '1';
  });
</script>
