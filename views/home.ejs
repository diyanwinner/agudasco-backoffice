<% layout('layout', {active:'home'}) %>
<section class="hero">
  <h1>Selamat datang di AGUDASCO</h1>
  <p class="meta">Kabar terbaru dan kegiatan terkini.</p>
</section>

<h3>Banner</h3>
<div class="grid cards">
  <% (banners||[]).forEach(b=>{ %>
    <div class="card">
      <img src="<%= b.image %>" alt="Banner"/>
    </div>
  <% }) %>
</div>

<h3 style="margin-top:24px;">Artikel Terbaru</h3>
<div class="grid cards">
  <% (arts||[]).forEach(a=>{ %>
    <div class="card">
      <img src="<%= a.image||'https://via.placeholder.com/640x360?text=Artikel' %>" alt="<%= a.title %>"/>
      <div class="pad">
        <h4><a href="/artikel/<%= a.id %>"><%= a.title %></a></h4>
        <p class="meta"><%= new Date(a.created_at).toLocaleDateString('id-ID') %></p>
        <a class="btn" href="/artikel/<%= a.id %>">Baca</a>
      </div>
    </div>
  <% }) %>
</div>
