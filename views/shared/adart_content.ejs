<!-- views/shared/adart_content.ejs -->
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h3 mb-1">AD/ART AGUDASCO</h1>
      <div class="text-secondary">Dokumen Anggaran Dasar & Anggaran Rumah Tangga</div>
    </div>
    <a href="/" class="btn btn-outline-secondary">← Beranda</a>
  </div>

  <% if (adarts && adarts.length) { %>
    <div class="row g-4">
      <% adarts.forEach((doc, i) => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm border-0">
            <% if (doc.cover) { %>
              <img src="<%= doc.cover %>" class="card-img-top" alt="<%= doc.title %>">
            <% } else { %>
              <div class="ratio ratio-16x9 bg-dark-subtle d-flex align-items-center justify-content-center text-secondary">
                <span>Tanpa Sampul</span>
              </div>
            <% } %>

            <div class="card-body d-flex flex-column">
              <h5 class="card-title mb-2"><%= doc.title %></h5>
              <div class="mt-auto d-flex gap-2">
                <% if (doc.pdf_url) { %>
                  <!-- Buka di modal -->
                  <button type="button"
                          class="btn btn-primary"
                          data-bs-toggle="modal"
                          data-bs-target="#pdfModal-<%= i %>">
                    Baca
                  </button>
                  <a class="btn btn-outline-light" href="<%= doc.pdf_url %>" target="_blank" rel="noopener">
                    Buka Tab
                  </a>
                <% } else { %>
                  <span class="text-secondary">Belum ada tautan PDF</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <% if (doc.pdf_url) { %>
          <!-- Modal PDF -->
          <div class="modal fade" id="pdfModal-<%= i %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
              <div class="modal-content bg-dark text-light">
                <div class="modal-header border-secondary">
                  <h5 class="modal-title"><%= doc.title %></h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                  <div class="ratio ratio-16x9">
                    <!-- Langsung render PDF di iframe -->
                    <iframe
                      src="<%= doc.pdf_url %>#view=FitH"
                      title="<%= doc.title %>"
                      allow="clipboard-write"
                      style="border:0"></iframe>
                  </div>
                </div>
                <div class="modal-footer border-secondary">
                  <a class="btn btn-outline-light" href="<%= doc.pdf_url %>" target="_blank" rel="noopener">Buka di Tab Baru</a>
                  <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Tutup</button>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      <% }); %>
    </div>
  <% } else { %>
    <div class="alert alert-info mb-0">
      Belum ada dokumen AD/ART yang dipublikasikan.
    </div>
  <% } %>
</div>
