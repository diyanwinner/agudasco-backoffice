<figure class="media-preview" onclick="openLightbox('<%= item.cover %>', '<%= item.title %>')">
  <img class="media-fit" src="<%= item.cover || 'https://via.placeholder.com/1200x800?text=AD/ART' %>" alt="<%= item.title %>">
  <figcaption class="media-caption">Klik gambar untuk memperbesar</figcaption>
</figure>

<div class="card">
  <div class="pad">
    <h1 class="hero-title"><%= item.title %></h1>

    <% if (item.pdf_url) { %>
      <a class="btn red" href="<%= item.pdf_url %>" target="_blank" rel="noopener">Buka / Unduh PDF</a>
    <% } else { %>
      <p class="meta">Belum ada file PDF.</p>
    <% } %>
  </div>
</div>
