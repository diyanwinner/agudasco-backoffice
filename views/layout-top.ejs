<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= (typeof title !== 'undefined' ? title + ' · ' : '') %>AGUDASCO</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- THEME utama gelap + util -->
  <style>
    :root { --navH: 64px; }
    @media (min-width: 992px) { :root { --navH: 72px; } }

    body { background:#0b1220; color:#eaeef7; padding-top:var(--navH); }
    .border-dashed { border:1px dashed #445; }
    .nav-link.active { font-weight:600; color:#0dcaf0 !important; }
    .navbar-brand { font-weight:600; letter-spacing:.5px; }
    footer { color:#99a3b3; }

    /* ==== Skin gelap untuk halaman form (pakai class .form-dark di body) ==== */
    .form-dark .card,
    .form-dark .card-header,
    .form-dark .card-body {
      background:#111827;
      border-color:#293248;
      color:#e5e7eb;
    }
    .form-dark .form-label { color:#cbd5e1; }

    .form-dark .form-control,
    .form-dark .form-select,
    .form-dark .form-control:disabled,
    .form-dark .form-select:disabled {
      background:#0f172a;
      color:#e5e7eb;
      border-color:#334155;
    }
    .form-dark .form-control::placeholder { color:#94a3b8; }
    .form-dark .form-control:focus,
    .form-dark .form-select:focus {
      background:#0f172a;
      color:#fff;
      border-color:#38bdf8;
      box-shadow:0 0 0 .2rem rgba(56,189,248,.15);
    }
    .form-dark .input-group-text {
      background:#0f172a;
      color:#cbd5e1;
      border-color:#334155;
    }
    .form-dark .form-check-input { background:#0f172a; border-color:#334155; }
    .form-dark .form-check-input:checked { background:#38bdf8; border-color:#38bdf8; }

    .form-dark .placeholder-panel {
      background:#0f172a; border:1px dashed #334155; color:#94a3b8;
    }

    .btn-primary { background:#0ea5e9; border-color:#0ea5e9; }
    .btn-primary:hover { background:#0284c7; border-color:#0284c7; }
    .btn-outline-light { color:#e5e7eb; border-color:#475569; }
    .btn-outline-light:hover { background:#1f2937; border-color:#64748b; color:#fff; }

    /* ==== Floating WhatsApp ==== */
    .wa-float{
      position: fixed;
      right: 16px;
      bottom: 16px;
      z-index: 2147483647 !important;   /* paling atas */
      display: flex;
      align-items: center;
      gap: .5rem;
      pointer-events: auto;
    }
    .wa-float .wa-btn{
      width: 56px; height: 56px;
      border: 0; border-radius: 9999px;
      background: #25D366;
      color: #0b1220;
      display: grid; place-items: center;
      box-shadow: 0 12px 24px rgba(37,211,102,.35);
      cursor: pointer;
      transition: transform .15s ease, box-shadow .15s ease;
    }
    .wa-float .wa-btn:hover{ transform: translateY(-1px); box-shadow: 0 16px 28px rgba(37,211,102,.45); }
    .wa-float .wa-btn:active{ transform: translateY(0); box-shadow: 0 8px 18px rgba(37,211,102,.35); }

    .wa-float .wa-label{
      background:#111827;
      color:#e5e7eb;
      border:1px solid #293248;
      font-weight:600; font-size:14px;
      padding:.45rem .65rem;
      border-radius:9999px;
      white-space:nowrap;
      box-shadow:0 10px 24px rgba(0,0,0,.35);
      opacity:0;
      transform: translateX(8px) scale(.98);
      transition: opacity .18s ease, transform .18s ease;
      pointer-events:none;
    }
    .wa-float:hover .wa-label,
    .wa-float:focus-within .wa-label{
      opacity:1; transform: translateX(0) scale(1);
    }
    @media (max-width:576px){
      .wa-float{ right:12px; bottom:12px; }
      .wa-float .wa-btn{ width:54px; height:54px; }
      .wa-float .wa-label{ display:none; }
    }
    @media (prefers-reduced-motion:reduce){
      .wa-float .wa-btn, .wa-float .wa-label{ transition:none; }
    }
  </style>
</head>

<!-- bodyClass opsional, misal 'form-dark' untuk halaman form -->
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <!-- Navbar -->
  <nav class="navbar navbar-dark bg-dark fixed-top border-bottom border-secondary navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/public/logo.png" alt="AGUDASCO" height="28" />
        <span>AGUDASCO</span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link <%= active==='admin'?'active':'' %>" href="/admin">Admin</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/members">Anggota</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/articles">Artikel</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/banners">Banner</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/reports">Laporan</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/adarts">AD/ART</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/contact">Kontak</a></li>
        </ul>
      </div>
    </div>
  </nav>
