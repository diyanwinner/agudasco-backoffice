<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'AGUDASCO' %></title>
  
  <link rel="icon" href="https://res.cloudinary.com/dsyo0e3fu/image/upload/f_auto,q_auto,c_scale,w_64/v1760066670/AgudascoLogo_resize_injtq2.png" />

  <link rel="stylesheet" href="/public/styles.css" />

  <style>
    :root {
      --header-h: 64px;
      --bg: #0b1220;
      --border: #223241;
      --text: #fff;
      --gutter: clamp(12px, 3vw, 24px);
    }

    /* Reset Body */
    body { padding-top: var(--header-h); background: var(--bg); color: var(--text); margin: 0; }

    /* Header Fixed */
    .site-header {
      position: fixed; inset: 0 0 auto 0; height: var(--header-h);
      z-index: 9999; /* Z-Index Tinggi biar diatas Flipbook */
      background: var(--bg); border-bottom: 1px solid var(--border);
    }

    /* Pembungkus Header (Flexbox) */
    .header-wrap { 
      height: 100%; width: 100%; display: flex; align-items: center;
      padding: 0 var(--gutter); position: relative; justify-content: space-between;
    }

    /* Logo */
    .brand { 
      color: inherit; text-decoration:none; font-weight:700; 
      display: flex; align-items: center; gap: 10px; z-index: 10002;
    }
    .brand img { display: block; }

    /* Menu Desktop */
    .nav-desktop a { 
      color:#fff; text-decoration:none; padding:10px 12px; display:inline-block; transition: color .2s;
    }
    .nav-desktop a.active, .nav-desktop a:hover { color: #9ec1ff; font-weight:700; }

    /* Logic Desktop (Layar Besar) */
    @media (min-width: 993px) {
      .header-wrap { justify-content: center; }
      .brand { position: absolute; left: var(--gutter); }
      .nav-toggle { display: none; }
    }

    /* Logic Mobile (Layar Kecil) */
    @media (max-width: 992px) {
      .nav-desktop { display: none; }
      .nav-toggle { display: flex; }
    }

    /* Tombol Hamburger */
    .nav-toggle { 
      border:0; background:transparent; padding:10px; cursor: pointer; 
      z-index: 10003; /* Harus paling atas */
      flex-direction: column; gap: 4px;
    }
    .nav-toggle span { 
      width: 24px; height: 2px; background: #fff; display: block; transition: .2s; 
    }
    /* Animasi Silang */
    .nav-toggle.is-open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
    .nav-toggle.is-open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    /* Mobile Overlay Menu */
    .mobile-nav { 
      position: fixed; inset: 0; z-index: 10000; background: var(--bg); 
      padding-top: var(--header-h); 
      display: none; /* Default Hidden */
      flex-direction: column;
    }
    .mobile-nav.active { display: flex; }

    .mobile-nav__list { 
      list-style:none; padding:20px; margin:0; display:grid; gap:10px; overflow-y: auto; 
    }
    .mobile-nav__list a {
      display:block; padding:12px 16px; border:1px solid var(--border);
      border-radius:12px; text-decoration:none; color:#fff; background: rgba(255,255,255,.05);
      font-size: 1rem;
    }

    /* Backdrop Hitam */
    .nav-backdrop { 
      position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,.6); 
      display: none; 
    }
    .nav-backdrop.active { display: block; }
    .body--lock { overflow: hidden; }
  </style>
</head>

<body class="page-<%= (typeof active !== 'undefined' ? active : '') %>">

  <header class="site-header">
    <div class="header-wrap">
      
      <a href="/" class="brand">
        <img src="https://res.cloudinary.com/dsyo0e3fu/image/upload/f_auto,q_auto,c_scale,w_44/v1760066670/AgudascoLogo_resize_injtq2.png" alt="Logo" width="44" height="44" />
        <div class="title">AGUDASCO</div>
      </a>

      <nav class="nav-desktop">
        <a href="/"        class="<%= active==='home'?'active':'' %>">Beranda</a>
        <a href="/artikel" class="<%= active==='artikel'?'active':'' %>">Artikel</a>
        <a href="/laporan" class="<%= active==='laporan'?'active':'' %>">Laporan</a>
        <a href="/adart"   class="<%= active==='adart'?'active':'' %>">AD/ART</a>
        <a href="/anggota" class="<%= active==='anggota'?'active':'' %>">Anggota</a>
        <a href="/galeri"  class="<%= active==='galeri'?'active':'' %>">Galeri</a>
        <a href="/tentang" class="<%= active==='tentang'?'active':'' %>">Tentang</a>
        <a href="/kontak"  class="<%= active==='kontak'?'active':'' %>">Kontak</a>
        <a href="/admin"   class="<%= active==='admin'?'active':'' %>">Admin</a>
      </nav>

      <button class="nav-toggle" id="btnToggle" onclick="toggleMenu()">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <nav class="mobile-nav" id="panelMenu">
    <ul class="mobile-nav__list">
      <li><a href="/">Beranda</a></li>
      <li><a href="/artikel">Artikel</a></li>
      <li><a href="/laporan">Laporan</a></li>
      <li><a href="/adart">AD/ART</a></li>
      <li><a href="/anggota">Anggota</a></li>
      <li><a href="/galeri">Galeri</a></li>
      <li><a href="/tentang">Tentang</a></li>
      <li><a href="/kontak">Kontak</a></li>
      <li><a href="/admin">Admin</a></li>
    </ul>
  </nav>
  <div class="nav-backdrop" id="backdropMenu" onclick="toggleMenu()"></div>

  <script>
    function toggleMenu() {
      const btn = document.getElementById('btnToggle');
      const panel = document.getElementById('panelMenu');
      const back = document.getElementById('backdropMenu');
      
      // Cek status saat ini
      const isOpen = btn.classList.contains('is-open');

      if (isOpen) {
        // TUTUP
        btn.classList.remove('is-open');
        panel.classList.remove('active');
        back.classList.remove('active');
        document.body.classList.remove('body--lock');
      } else {
        // BUKA
        btn.classList.add('is-open');
        panel.classList.add('active');
        back.classList.add('active');
        document.body.classList.add('body--lock');
      }
    }
  </script>

  <main>
