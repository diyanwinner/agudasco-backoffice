<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= typeof title !== 'undefined' ? title : 'AGUDASCO' %></title>

  <!-- Favicon pakai Cloudinary (auto format & kompresi) -->
  <link rel="icon"
        href="https://res.cloudinary.com/dsyo0e3fu/image/upload/f_auto,q_auto,c_scale,w_64/v1760066670/AgudascoLogo_resize_injtq2.png"/>

  <!-- Styles -->
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="container header-wrap">
      <!-- Brand: jadikan link -->
      <a href="/" class="brand" aria-label="Halaman beranda AGUDASCO">
        <img
          class="logo"
          src="https://res.cloudinary.com/dsyo0e3fu/image/upload/f_auto,q_auto,c_scale,w_44/v1760066670/AgudascoLogo_resize_injtq2.png"
          srcset="
            https://res.cloudinary.com/dsyo0e3fu/image/upload/f_auto,q_auto,c_scale,w_44/v1760066670/AgudascoLogo_resize_injtq2.png 1x,
            https://res.cloudinary.com/dsyo0e3fu/image/upload/f_auto,q_auto,c_scale,w_88/v1760066670/AgudascoLogo_resize_injtq2.png 2x
          "
          alt="Logo AGUDASCO"
          width="44" height="44"
          loading="eager" decoding="async" />
        <div class="title">AGUDASCO</div>
      </a>

      <!-- Tombol hamburger (mobile) -->
      <button class="nav-toggle" aria-controls="main-nav" aria-expanded="false" aria-label="Buka navigasi">
        <span></span><span></span><span></span>
      </button>

      <!-- Nav -->
      <nav id="main-nav" class="nav" aria-label="Navigasi utama">
        <a href="/" class="<%= (locals.active==='home') ? 'active' : '' %>">Beranda</a>
        <a href="/artikel" class="<%= (locals.active==='artikel') ? 'active' : '' %>">Artikel</a>
        <a href="/laporan" class="<%= (locals.active==='laporan') ? 'active' : '' %>">Laporan</a>
        <a href="/adart" class="<%= (locals.active==='adart') ? 'active' : '' %>">AD/ART</a>
        <a href="/anggota" class="<%= (locals.active==='anggota') ? 'active' : '' %>">Anggota</a>
        <a href="/galeri" class="<%= (locals.active==='galeri') ? 'active' : '' %>">Galeri</a>
        <a href="/tentang" class="<%= (locals.active==='tentang') ? 'active' : '' %>">Tentang</a>
        <a href="/kontak" class="<%= (locals.active==='kontak') ? 'active' : '' %>">Kontak</a>
        <a href="/admin" class="<%= (locals.active==='admin') ? 'active' : '' %>">Admin</a>
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main>
    <div class="container">
      <%- body %>
    </div>
  </main>

  <!-- Footer partial -->
  <%- include('partials/footer') %>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox-backdrop" onclick="closeLightbox(event)">
    <div>
      <img id="lightbox-img" class="lightbox-img" src="" alt=""/>
      <div id="lightbox-cap" class="lightbox-caption"></div>
    </div>
  </div>

  <script>
    // Lightbox
    function openLightbox(src, cap){
      const b = document.getElementById('lightbox');
      document.getElementById('lightbox-img').src = src;
      document.getElementById('lightbox-cap').textContent = cap || '';
      b.classList.add('active');
    }
    function closeLightbox(e){
      if (e.target.id === 'lightbox') {
        document.getElementById('lightbox').classList.remove('active');
      }
    }

    // Toggle mobile nav
    (function(){
      const btn = document.querySelector('.nav-toggle');
      const nav = document.getElementById('main-nav');
      const root = document.documentElement;
      if(!btn || !nav) return;
      btn.addEventListener('click', () => {
        const open = nav.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.classList.toggle('is-open', open);
        root.classList.toggle('no-scroll', open);
      });
    })();
  </script>
</body>
</html>
