<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title><%= typeof title !== 'undefined' ? title : 'AGUDASCO' %></title>

  <link rel="icon" href="https://res.cloudinary.com/dsyo0e3fu/image/upload/f_auto,q_auto,c_scale,w_64/v1760066670/AgudascoLogo_resize_injtq2.png" />
  
  <link rel="stylesheet" href="/public/styles.css?v=<%= buildId %>" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --header-h: 70px;
      --bg: #020617; /* Slate-950 (Lebih gelap & elegan) */
      --text: #f8fafc;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --glass: rgba(15, 23, 42, 0.7);
      --border: rgba(255, 255, 255, 0.08);
      --gutter: clamp(20px, 5vw, 40px);
    }
    
    body {
      padding-top: var(--header-h);
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      overflow-x: hidden; /* Anti scroll samping */
    }
    
    /* --- HEADER GLASSMORPHISM --- */
    .site-header {
      position: fixed; inset: 0 0 auto 0;
      height: var(--header-h);
      z-index: 9999;
      background: var(--glass);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      transition: all 0.3s ease;
    }

    .header-wrap {
      max-width: 1280px; margin: 0 auto; height: 100%;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 var(--gutter);
    }

    /* LOGO KEREN */
    .brand {
      text-decoration: none; display: flex; align-items: center; gap: 10px;
      color: white; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.5px;
    }
    .brand img { transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .brand:hover img { transform: rotate(-10deg) scale(1.1); }
    
    /* NAVIGASI DESKTOP (KAPSUL) */
    .nav-desktop {
      display: flex; gap: 4px;
      background: rgba(255,255,255,0.03);
      padding: 4px; border-radius: 50px;
      border: 1px solid var(--border);
    }
    .nav-desktop a {
      color: #94a3b8; text-decoration: none;
      padding: 8px 18px; border-radius: 30px;
      font-size: 0.85rem; font-weight: 500;
      transition: all 0.2s ease;
    }
    .nav-desktop a:hover { color: white; background: rgba(255,255,255,0.06); }
    .nav-desktop a.active-menu {
      background: var(--primary); color: white; font-weight: 600;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    /* NAVIGASI MOBILE */
    .nav-toggle {
      display: none; background: transparent; border: none; cursor: pointer; padding: 10px;
    }
    .nav-toggle span {
      display: block; width: 24px; height: 2px; background: white;
      margin: 5px 0; transition: 0.3s; border-radius: 2px;
    }
    /* Animasi Hamburger jadi X */
    .nav-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle.is-open span:nth-child(2) { opacity: 0; transform: translateX(-10px); }
    .nav-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mobile-menu-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.6);
      backdrop-filter: blur(8px); z-index: 9998;
      opacity: 0; pointer-events: none; transition: 0.3s;
    }
    .mobile-menu-overlay.active { opacity: 1; pointer-events: all; }

    .mobile-menu {
      position: fixed; top: 0; right: 0; width: 280px; height: 100vh;
      background: #0f172a; z-index: 9999;
      padding: 80px 20px 20px;
      transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: -10px 0 30px rgba(0,0,0,0.5);
      border-left: 1px solid var(--border);
    }
    .mobile-menu.active { transform: translateX(0); }
    
    .mobile-link {
      display: block; padding: 12px 16px; margin-bottom: 8px;
      color: #cbd5e1; text-decoration: none; font-weight: 500;
      border-radius: 12px; transition: 0.2s;
    }
    .mobile-link:hover { background: rgba(255,255,255,0.05); color: white; }
    .mobile-link.active-menu { background: rgba(37, 99, 235, 0.15); color: #60a5fa; border: 1px solid rgba(37, 99, 235, 0.3); }

    /* LIGHTBOX GAMBAR */
    .lightbox {
      position: fixed; inset: 0; z-index: 10000;
      background: rgba(0,0,0,0.9);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: 0.3s;
    }
    .lightbox.active { opacity: 1; pointer-events: all; }
    .lightbox img {
      max-width: 90vw; max-height: 80vh; border-radius: 8px;
      box-shadow: 0 0 50px rgba(0,0,0,0.5);
      transform: scale(0.9); transition: 0.3s;
    }
    .lightbox.active img { transform: scale(1); }
    .lightbox-caption { color: #ccc; margin-top: 15px; text-align: center; font-size: 0.9rem; }
    .lightbox-close {
      position: absolute; top: 20px; right: 20px;
      background: rgba(255,255,255,0.1); color: white;
      border: none; width: 40px; height: 40px; border-radius: 50%;
      font-size: 1.5rem; cursor: pointer; display: flex; align-items: center; justify-content: center;
    }

    @media (max-width: 992px) {
      .nav-desktop { display: none; }
      .nav-toggle { display: block; }
    }
  </style>
</head>

<body>
  
  <header class="site-header">
    <div class="header-wrap">
      
      <a href="/" class="brand">
        <img src="https://res.cloudinary.com/dsyo0e3fu/image/upload/f_auto,q_auto,c_scale,w_44/v1760066670/AgudascoLogo_resize_injtq2.png" 
             alt="Logo AGUDASCO" width="40" height="40" />
        <span>AGUDASCO</span>
      </a>

      <nav class="nav-desktop">
        <a href="/"        class="<%= (typeof active!='undefined' && active==='home')?'active-menu':'' %>">Beranda</a>
        <a href="/artikel" class="<%= (typeof active!='undefined' && active==='artikel')?'active-menu':'' %>">Artikel</a>
        <a href="/dokumen" class="<%= (typeof active!='undefined' && active==='dokumen')?'active-menu':'' %>">Dokumen</a>
        <a href="/anggota" class="<%= (typeof active!='undefined' && active==='anggota')?'active-menu':'' %>">Anggota</a>
        <a href="/galeri"  class="<%= (typeof active!='undefined' && active==='galeri')?'active-menu':'' %>">Galeri</a>
        <a href="/#contact-section">Kontak</a>
        
        <% if (typeof user !== 'undefined' && user) { %>
          <div style="display: flex; gap: 5px; margin-left: 10px; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 10px;">
            <a href="/admin" class="active-menu" style="background: #ef4444; border-color: #ef4444;">Admin Panel</a>
            <a href="/logout" style="color: #f87171;" title="Keluar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            </a>
          </div>
        <% } else { %>
          <a href="/login">Login</a>
        <% } %>
      </nav>

      <button class="nav-toggle" id="navToggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>

    </div>
  </header>

  <div class="mobile-menu-overlay" id="mobileOverlay"></div>
  <nav class="mobile-menu" id="mobileMenu">
    <div style="margin-bottom: 30px; opacity: 0.5; font-size: 0.8rem; letter-spacing: 1px;">MENU UTAMA</div>
    
    <a href="/"        class="mobile-link <%= active==='home'?'active-menu':'' %>">🏠 Beranda</a>
    <a href="/artikel" class="mobile-link <%= active==='artikel'?'active-menu':'' %>">📝 Artikel</a>
    <a href="/dokumen" class="mobile-link <%= active==='dokumen'?'active-menu':'' %>">📂 Dokumen Resmi</a>
    <a href="/anggota" class="mobile-link <%= active==='anggota'?'active-menu':'' %>">👥 Anggota</a>
    <a href="/galeri"  class="mobile-link <%= active==='galeri'?'active-menu':'' %>">📸 Galeri Foto</a>
    <a href="/#contact-section" class="mobile-link">📞 Kontak Kami</a>
    
    <hr style="border-color: rgba(255,255,255,0.1); margin: 20px 0;">
    
    <% if (user) { %>
      <a href="/admin" class="mobile-link" style="color: #ef4444;">🔐 Admin Panel</a>
    <% } else { %>
      <a href="/login" class="mobile-link">🔐 Login Pengurus</a>
    <% } %>
  </nav>

  <main>
    <%- body %>
  </main>

  <%- include('partials/footer') %>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
    <img id="lightbox-img" src="" alt="Preview">
    <div class="lightbox-caption" id="lightbox-cap"></div>
  </div>

  <script>
    // 1. Logic Menu Mobile
    const toggle = document.getElementById('navToggle');
    const menu = document.getElementById('mobileMenu');
    const overlay = document.getElementById('mobileOverlay');

    function toggleMenu() {
      const isOpen = menu.classList.contains('active');
      if (isOpen) {
        menu.classList.remove('active');
        overlay.classList.remove('active');
        toggle.classList.remove('is-open');
        document.body.style.overflow = ''; // Balikin scroll
      } else {
        menu.classList.add('active');
        overlay.classList.add('active');
        toggle.classList.add('is-open');
        document.body.style.overflow = 'hidden'; // Kunci scroll biar fokus menu
      }
    }

    toggle.addEventListener('click', toggleMenu);
    overlay.addEventListener('click', toggleMenu);

    // 2. Logic Lightbox (Buat Galeri)
    function openLightbox(src, caption) {
      const lb = document.getElementById('lightbox');
      const img = document.getElementById('lightbox-img');
      const cap = document.getElementById('lightbox-cap');
      
      img.src = src;
      cap.textContent = caption || '';
      lb.classList.add('active');
    }

    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('active');
    }

    // Tutup lightbox kalau klik area gelap (bukan gambarnya)
    document.getElementById('lightbox').addEventListener('click', function(e) {
      if(e.target === this) closeLightbox();
    });

    // Tutup pakai tombol ESC
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeLightbox();
        if (menu.classList.contains('active')) toggleMenu();
      }
    });
  </script>

</body>
</html>
