<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= typeof title !== 'undefined' ? title : 'AGUDASCO' %></title>

  <!-- Styles -->
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="container">
      <div class="brand">
        <img
          src="https://res.cloudinary.com/<%= (process.env.CLOUDINARY_CLOUD_NAME||'dsyo0e3fu') %>/image/upload/c_scale,w_40/v1710000000/logo.png"
          alt="Logo" width="40" height="40" />
        <div class="title">AGUDASCO</div>
      </div>

      <nav class="nav">
        <a href="/"
           class="<%= (locals.active==='home') ? 'active' : '' %>">Beranda</a>
        <a href="/artikel"
           class="<%= (locals.active==='artikel') ? 'active' : '' %>">Artikel</a>
        <a href="/laporan"
           class="<%= (locals.active==='laporan') ? 'active' : '' %>">Laporan</a>
        <a href="/adart"
           class="<%= (locals.active==='adart') ? 'active' : '' %>">AD/ART</a>
        <a href="/anggota"
           class="<%= (locals.active==='anggota') ? 'active' : '' %>">Anggota</a>
        <a href="/galeri"
           class="<%= (locals.active==='galeri') ? 'active' : '' %>">Galeri</a>
        <a href="/tentang"
           class="<%= (locals.active==='tentang') ? 'active' : '' %>">Tentang</a>
        <a href="/kontak"
           class="<%= (locals.active==='kontak') ? 'active' : '' %>">Kontak</a>
        <a href="/admin"
           class="<%= (locals.active==='admin') ? 'active' : '' %>">Admin</a>
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main>
    <div class="container">
      <%- body %>
    </div>
  </main>

  <!-- Footer (pakai partial) -->
  <%- include('partials/footer') %>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox-backdrop" onclick="closeLightbox(event)">
    <div>
      <img id="lightbox-img" class="lightbox-img" src="" alt=""/>
      <div id="lightbox-cap" class="lightbox-caption"></div>
    </div>
  </div>

  <script>
    function openLightbox(src, cap){
      const b = document.getElementById('lightbox');
      document.getElementById('lightbox-img').src = src;
      document.getElementById('lightbox-cap').textContent = cap || '';
      b.classList.add('active');
    }
    function closeLightbox(e){
      // Tutup kalau klik backdrop atau tombol close (kalau nanti ditambah)
      if(e.target.id==='lightbox'){ document.getElementById('lightbox').classList.remove('active'); }
    }
  </script>
</body>
</html>
