<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= title || "AGUDASCO" %></title>

  <!-- Bootstrap 5 CSS (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>

  <!-- App CSS -->
  <link rel="stylesheet" href="/public/style.css"/>
</head>
<body class="bg-dark text-light">

  <!-- TOPBAR -->
  <header class="topbar border-bottom border-secondary">
    <div class="container d-flex justify-content-between align-items-center py-2">
      <a href="/" class="logo text-decoration-none">AGUDASCO</a>

      <!-- NAV RIGHT -->
      <nav class="main-nav">
        <a href="/" class="nav-item-link">Beranda</a>
        <span class="sep">|</span>
        <a href="/laporan" class="nav-item-link">Laporan Keuangan</a>
        <span class="sep">|</span>
        <a href="/admin" class="nav-item-link">Admin</a>
      </nav>
    </div>
  </header>

  <!-- PAGE BODY -->
  <main class="container py-3">
    <%- body %>
  </main>

  <!-- FOOTER -->
  <footer class="py-4 border-top border-secondary text-center text-muted small">
    © <%= new Date().getFullYear() %> AGUDASCO
  </footer>

  <!-- Bootstrap 5 JS (CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
