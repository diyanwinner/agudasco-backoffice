<section class="container">
  <article class="card">
    <h1><%= article.title %></h1>
    <div class="muted"><%= new Date(article.created_at).toLocaleString() %></div>
    <% if (article.image) { %>
      <img src="<%= article.image %>" alt="<%= article.title %>" style="width:100%; margin:12px 0; border-radius:8px;">
    <% } %>
    <div><%- article.content %></div>
  </article>
</section>
