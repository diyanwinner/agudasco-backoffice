<%- include('partials/flash') %>
<div class="container py-6">
  <h1 class="mb-4">Artikel</h1>

  <% if (!articles || articles.length === 0) { %>
    <p>Belum ada artikel.</p>
  <% } else { %>
    <div class="cards" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px">
      <% articles.forEach(a => { %>
        <div class="card" style="background:#0e1624;border-radius:12px;overflow:hidden;border:1px solid #223">
          <% if (a.image) { %>
            <img src="<%= a.image %>" alt="<%= a.title %>" style="width:100%;height:160px;object-fit:cover">
          <% } %>
          <div style="padding:14px">
            <h3 style="margin:0 0 8px 0;font-size:18px"><%= a.title %></h3>
            <a class="btn" href="/article/<%= a.id %>" style="display:inline-block;padding:8px 12px;border-radius:8px;background:#1b2a44;color:#fff;text-decoration:none">Baca</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
