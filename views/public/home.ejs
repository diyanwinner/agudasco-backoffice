<% layout('layout', { title: 'AGUDASCO – Beranda' }) %>
<h1>AGUDASCO</h1>
<!-- HERO BANNER -->
<div class="card" style="padding:0; overflow:hidden">
  <div id="heroSlider" class="tns-carousel" style="aspect-ratio:16/9">
    <div>
      <img
        src="https://res.cloudinary.com/dsyo0e3fu/image/upload/v1759492423/agudasco/1759492421911_WhatsApp_Image_2025-10-01_at_11.06.57_170c5fc9.jpg.jpg"
        alt="Banner 1 AGUDASCO"
        loading="eager"
        style="width:100%; height:100%; object-fit:cover">
    </div>
    <div>
      <img
        src="https://res.cloudinary.com/dsyo0e3fu/image/upload/v1759492436/agudasco/1759492434470_WhatsApp_Image_2025-09-25_at_16.55.36_38f341d2.jpg.jpg"
        alt="Banner 2 AGUDASCO"
        loading="lazy"
        style="width:100%; height:100%; object-fit:cover">
    </div>
    <div>
      <img
        src="https://res.cloudinary.com/dsyo0e3fu/image/upload/v1759492493/agudasco/1759492491257_WhatsApp_Image_2025-03-20_at_04.51.10_5fd53cff.jpg.jpg"
        alt="Banner 3 AGUDASCO"
        loading="lazy"
        style="width:100%; height:100%; object-fit:cover">
    </div>
  </div>
</div>
<div class="cards">
  <% arts.forEach(a => { %>
    <a class="card" href="/article/<%= a.slug %>">
      <h3><%= a.title %></h3>
      <div class="muted"><%= new Date(a.created_at).toLocaleString() %></div>
      <div><%- (a.content || '').slice(0,180) %>…</div>
    </a>
  <% }) %>
  <% if (!arts.length) { %><div class="muted">Belum ada artikel dipublikasi.</div><% } %>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const el = document.getElementById('heroSlider');
    if (!el || !window.tns) { return; }

    tns({
      container: el,
      items: 1,
      slideBy: 1,
      autoplay: true,
      autoplayTimeout: 4000,
      autoplayButtonOutput: false,
      controls: true,
      controlsText: ['‹','›'],
      nav: true,
      mouseDrag: true,
      loop: true,
      speed: 400
    });
  });
</script>
