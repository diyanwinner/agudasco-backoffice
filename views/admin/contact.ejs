<div class="admin-wrap">
  <div class="admin-head">
    <h1 class="admin-title">Kelola Kontak</h1>
    <a class="btn ghost" href="/admin">← Dashboard</a>
  </div>

  <form class="card" method="post" action="/admin/contact" style="display:grid; gap:12px; padding:16px">
    <div class="grid" style="grid-template-columns:1fr 1fr; gap:12px">
      <div>
        <label class="label">Nama Organisasi</label>
        <input class="input" type="text" name="org_name" value="<%= (info && info.org_name) || '' %>" placeholder="AGUDASCO">
      </div>
      <div>
        <label class="label">Email</label>
        <input class="input" type="email" name="email" value="<%= (info && info.email) || '' %>" placeholder="info@agudasco.org">
      </div>
      <div>
        <label class="label">Telepon</label>
        <input class="input" type="text" name="phone" value="<%= (info && info.phone) || '' %>" placeholder="+62 8xx xxxx">
      </div>
      <div>
        <label class="label">WhatsApp</label>
        <input class="input" type="text" name="whatsapp" value="<%= (info && info.whatsapp) || '' %>" placeholder="628xxxx (angka saja/tautan)">
      </div>
      <div>
        <label class="label">Instagram (URL)</label>
        <input class="input" type="text" name="instagram" value="<%= (info && info.instagram) || '' %>" placeholder="https://instagram.com/...">
      </div>
      <div>
        <label class="label">Facebook (URL)</label>
        <input class="input" type="text" name="facebook" value="<%= (info && info.facebook) || '' %>" placeholder="https://facebook.com/...">
      </div>
      <div>
        <label class="label">X/Twitter (handle atau URL)</label>
        <input class="input" type="text" name="x_handle" value="<%= (info && info.x_handle) || '' %>" placeholder="@agudasco">
      </div>
      <div>
        <label class="label">Maps URL (embed/share link)</label>
        <input class="input" type="text" name="maps_url" value="<%= (info && info.maps_url) || '' %>" placeholder="https://maps.google.com/...">
      </div>
    </div>

    <div>
      <label class="label">Alamat</label>
      <textarea class="input" name="address" rows="3" placeholder="Alamat lengkap"><%= (info && info.address) || '' %></textarea>
    </div>

    <div class="form-bar">
      <span class="muted">Terakhir diperbarui: <%= info?.updated_at ? new Date(info.updated_at).toLocaleString('id-ID') : '—' %></span>
      <button class="btn">Simpan</button>
    </div>
  </form>

  <div class="card" style="padding:16px; margin-top:12px">
    <h3 style="margin-top:0">Pratinjau</h3>
    <p><strong><%= info?.org_name || '—' %></strong></p>
    <p>Email: <%= info?.email || '—' %> · Telp: <%= info?.phone || '—' %> · WA: <%= info?.whatsapp || '—' %></p>
    <p>Alamat: <%= info?.address || '—' %></p>
    <% if (info?.maps_url) { %>
      <div style="border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-top:8px">
        <iframe src="<%= info.maps_url %>" width="100%" height="300" style="border:0" loading="lazy"></iframe>
      </div>
    <% } %>
  </div>
</div>
