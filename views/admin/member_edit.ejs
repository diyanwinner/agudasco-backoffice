<% /* Dibungkus layout.ejs */ %>

<div class="container py-4">
  <div class="d-flex align-items-center gap-2 mb-3">
    <a href="/admin/members" class="btn btn-outline-light btn-sm">← Kembali</a>
    <h1 class="h4 m-0">Edit Anggota</h1>
  </div>

  <form action="/admin/members/<%= member.id %>/update" method="POST" enctype="multipart/form-data" class="row g-4">
    <div class="col-lg-7">
      <!-- Nama -->
      <label class="form-label">Nama Lengkap</label>
      <input type="text" name="name" class="form-control" value="<%= member.name || '' %>" required />

      <!-- Tanggal lahir -->
      <div class="mt-3">
        <label class="form-label">Tanggal Lahir</label>
        <input type="date" name="birthdate" class="form-control" value="<%= member.birthdate ? member.birthdate.toISOString().slice(0,10) : '' %>" />
      </div>

      <!-- Bio -->
      <div class="mt-3">
        <label class="form-label">Bio / Keterangan</label>
        <textarea name="bio" rows="4" class="form-control"><%= member.bio || '' %></textarea>
      </div>

      <!-- Foto: Upload / URL -->
      <div class="mt-4">
        <label class="form-label d-block">Foto Anggota</label>
        <div class="btn-group mb-2" role="group">
          <button type="button" id="btnUpload" class="btn btn-primary btn-sm">Pakai Upload</button>
          <button type="button" id="btnUrl"     class="btn btn-outline-primary btn-sm">Pakai URL</button>
        </div>

        <div id="boxUpload">
          <input type="file" name="avatar" accept="image/*" class="form-control" />
          <div class="form-text">Jika diisi, akan menimpa foto lama.</div>
        </div>

        <div id="boxUrl" class="d-none">
          <input type="url" name="avatar" id="avatarUrl" class="form-control" placeholder="https://..." value=""/>
          <div class="form-text">Atau isi URL baru. Jika kosong, foto tetap memakai yang sekarang.</div>
        </div>
      </div>

      <div class="mt-4 d-flex gap-2">
        <a href="/admin/members" class="btn btn-outline-light">Batal</a>
        <button class="btn btn-success">Simpan Perubahan</button>
      </div>
    </div>

    <!-- Preview -->
    <div class="col-lg-5">
      <label class="form-label">Preview Foto</label>
      <div class="border rounded-3 d-flex align-items-center justify-content-center" style="height:280px; background:rgba(255,255,255,.03);">
        <img id="previewImg" alt="Preview" style="max-width:100%; max-height:100%; display:<%= member.avatar ? 'block' : 'none' %>;"
             src="<%= member.avatar || '' %>" />
        <div id="previewEmpty" class="text-muted" style="display:<%= member.avatar ? 'none':'block' %>;">Belum ada gambar</div>
      </div>
    </div>
  </form>
</div>

<script>
  const btnUpload = document.getElementById('btnUpload');
  const btnUrl    = document.getElementById('btnUrl');
  const boxUpload = document.getElementById('boxUpload');
  const boxUrl    = document.getElementById('boxUrl');
  const fileInput = boxUpload.querySelector('input[type="file"]');
  const urlInput  = document.getElementById('avatarUrl');
  const img       = document.getElementById('previewImg');
  const empty     = document.getElementById('previewEmpty');

  function showUpload(){
    boxUpload.classList.remove('d-none');
    boxUrl.classList.add('d-none');
    btnUpload.classList.add('btn-primary'); btnUpload.classList.remove('btn-outline-primary');
    btnUrl.classList.add('btn-outline-primary'); btnUrl.classList.remove('btn-primary');
  }
  function showUrl(){
    boxUrl.classList.remove('d-none');
    boxUpload.classList.add('d-none');
    btnUrl.classList.add('btn-primary'); btnUrl.classList.remove('btn-outline-primary');
    btnUpload.classList.add('btn-outline-primary'); btnUpload.classList.remove('btn-primary');
  }
  btnUpload.addEventListener('click', showUpload);
  btnUrl.addEventListener('click', showUrl);

  function setPreview(src){
    if(src){
      img.src = src;
      img.style.display = 'block';
      empty.style.display = 'none';
    }else{
      img.style.display = 'none';
      empty.style.display = 'block';
    }
  }

  fileInput.addEventListener('change', () => {
    const f = fileInput.files?.[0];
    if(!f) return;
    const reader = new FileReader();
    reader.onload = e => setPreview(e.target.result);
    reader.readAsDataURL(f);
  });

  urlInput?.addEventListener('input', () => setPreview(urlInput.value.trim()));
</script>
