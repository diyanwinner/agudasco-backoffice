<!-- TIDAK ADA <% layout('layout') %> -->
<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 m-0">Edit Anggota</h1>
    <a href="/admin/members" class="btn btn-outline-secondary">← Kembali</a>
  </div>

  <form action="/admin/members/<%= member.id %>/update" method="post" enctype="multipart/form-data">
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card bg-dark-subtle border-0 shadow-sm">
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label">Nama Lengkap</label>
              <input name="name" type="text" class="form-control" value="<%- member.name || '' %>" required />
            </div>

            <div class="mb-3">
              <label class="form-label">Tanggal Lahir</label>
              <input name="birthdate" type="date" class="form-control" value="<%- member.birthdate ? member.birthdate.toISOString().slice(0,10) : '' %>" />
            </div>

            <div class="mb-3">
              <label class="form-label">Bio / Keterangan</label>
              <textarea name="bio" class="form-control" rows="4"><%- member.bio || '' %></textarea>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="card bg-dark-subtle border-0 shadow-sm h-100">
          <div class="card-body">
            <h5 class="card-title mb-3">Foto Anggota</h5>

            <div class="mb-3">
              <% if (member.avatar) { %>
                <img src="<%- member.avatar %>" alt="avatar" class="img-fluid rounded border mb-2" />
              <% } else { %>
                <div class="text-muted mb-2">Belum ada foto.</div>
              <% } %>
            </div>

            <div class="d-flex gap-2 mb-2">
              <button type="button" class="btn btn-primary btn-sm" onclick="useUpload()">Pakai Upload</button>
              <button type="button" class="btn btn-outline-primary btn-sm" onclick="useUrl()">Pakai URL</button>
            </div>

            <div id="fileWrap" class="mb-3">
              <input class="form-control" type="file" name="avatar" accept="image/*" />
              <div class="form-text">Jika diisi, akan menimpa foto lama.</div>
            </div>

            <div id="urlWrap" class="mb-3 d-none">
              <input class="form-control" type="url" name="avatar_url" placeholder="https://..." />
              <div class="form-text">Atau isi URL baru. Jika kosong, foto tetap memakai yang sekarang.</div>
            </div>

            <div class="d-flex gap-2">
              <a class="btn btn-secondary" href="/admin/members">Batal</a>
              <button class="btn btn-primary" type="submit">Simpan Perubahan</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
  function useUpload(){ document.getElementById('fileWrap').classList.remove('d-none'); document.getElementById('urlWrap').classList.add('d-none'); }
  function useUrl(){ document.getElementById('urlWrap').classList.remove('d-none'); document.getElementById('fileWrap').classList.add('d-none'); }
</script>
