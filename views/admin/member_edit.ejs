<%- include('../layout-top', { title: 'Edit Anggota', active: 'admin' }) %>

<div class="container admin-wrap">
  <div class="admin-head">
    <h1 class="admin-title">Edit Anggota</h1>
    <a href="/admin/members" class="btn ghost">← Kembali</a>
  </div>

  <form action="/admin/members/<%= member.id %>/update" method="POST" enctype="multipart/form-data" class="form-modern">
    
    <div class="form-grid-2">
      
      <div class="card pad">
        <label class="label">Foto Anggota</label>
        
        <div class="dropzone <%= member.avatar ? 'is-drag' : '' %>" id="dropArea">
          <input type="file" name="avatar" id="fileInput" accept="image/*" style="position:absolute;inset:0;opacity:0;cursor:pointer;z-index:2">
          
          <div class="dz-empty" id="dzEmpty" style="<%= member.avatar ? 'display:none' : 'display:flex' %>">
            <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
            <span>Klik / Timpa Foto Baru</span>
            <span style="font-size:12px;opacity:.5">(JPG, PNG, WebP)</span>
          </div>

          <div class="dz-preview" id="dzPreview" style="<%= member.avatar ? 'display:block' : 'display:none' %>">
            <img id="imgPreview" src="<%= member.avatar || '' %>" alt="Preview">
            <button type="button" class="dz-remove" id="btnRemove" title="Ganti Foto">×</button>
          </div>
        </div>

        <div class="mt-3 pt-3" style="border-top:1px solid rgba(255,255,255,0.1)">
          <label class="label" style="font-size:12px; margin-top:0;">URL Foto (Opsional)</label>
          <input type="text" name="avatar_url" class="input" placeholder="https://..." value="<%= member.avatar && member.avatar.startsWith('http') ? member.avatar : '' %>" style="font-size:13px; padding:8px;">
          <p class="text-secondary small mt-1" style="font-size:11px;">
            *Biarkan kosong jika tidak ingin mengubah URL.
          </p>
        </div>
      </div>

      <div class="card pad">
        <div class="mb-3">
          <label for="name" class="label">Nama Lengkap *</label>
          <input type="text" name="name" id="name" class="input" value="<%= member.name %>" required>
        </div>

        <div class="mb-3">
          <label for="birthdate" class="label">Tanggal Lahir</label>
          <input type="date" name="birthdate" id="birthdate" class="input" 
                 value="<%= member.birthdate ? new Date(member.birthdate).toISOString().split('T')[0] : '' %>">
        </div>

        <div class="mb-3">
          <label for="bio" class="label">Bio / Keterangan</label>
          <textarea name="bio" id="bio" class="textarea" rows="5"><%= member.bio || '' %></textarea>
        </div>

        <div class="form-bar" style="position:static; margin-top:20px; background:transparent; border:0; padding:0;">
          <a href="/admin/members" class="btn ghost">Batal</a>
          <button type="submit" class="btn">Simpan Perubahan</button>
        </div>
      </div>
      
    </div>
  </form>
</div>

<script>
  const fileInput = document.getElementById('fileInput');
  const dzEmpty = document.getElementById('dzEmpty');
  const dzPreview = document.getElementById('dzPreview');
  const imgPreview = document.getElementById('imgPreview');
  const btnRemove = document.getElementById('btnRemove');
  const dropArea = document.getElementById('dropArea');
  
  // Simpan foto lama untuk fitur 'Restore' kalau user batal ganti
  const originalSrc = "<%= member.avatar || '' %>";

  // 1. Saat file baru dipilih
  fileInput?.addEventListener('change', function(){
    const file = this.files[0];
    if(file){
      const reader = new FileReader();
      reader.onload = function(e){
        imgPreview.src = e.target.result;
        dzEmpty.style.display = 'none';
        dzPreview.style.display = 'block';
        dropArea.classList.add('is-drag');
      }
      reader.readAsDataURL(file);
    }
  });

  // 2. Tombol Reset/Hapus Preview
  btnRemove?.addEventListener('click', function(e){
    e.preventDefault();
    fileInput.value = ''; // Reset input file
    
    // Jika awalnya punya foto, kita kembalikan ke foto lama atau kosongkan visualnya?
    // Biasanya di form edit, 'X' berarti "Saya mau ganti / hapus preview baru ini"
    // Tapi karena logic backend beda-beda, amannya kita kosongkan visual agar user tau dia harus upload ulang
    
    imgPreview.src = '';
    dzEmpty.style.display = 'flex';
    dzPreview.style.display = 'none';
    dropArea.classList.remove('is-drag');
    
    // Opsional: Kalau mau canggih, bisa tambah logic hidden input untuk 'delete_avatar'
  });

  // 3. Drag Effect
  dropArea?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropArea.style.borderColor = '#2b72ff';
    dropArea.style.background = 'rgba(43,114,255,.06)';
  });
  dropArea?.addEventListener('dragleave', () => {
    // Kembalikan style hanya jika tidak sedang ada file terpilih/foto lama
    if(!fileInput.value && !imgPreview.getAttribute('src')) {
      dropArea.style.borderColor = '';
      dropArea.style.background = '';
    }
  });
</script>

<%- include('../layout-bottom') %>
