<main class="admin-wrap">
  <div class="container">
    <div class="admin-head">
      <h1 class="admin-title">Anggota</h1>
      <a href="/admin/members/new" class="btn">+ Tambah Anggota</a>
    </div>

    <div class="admin-members-grid">
      <% (members || []).forEach(function (m, idx) { %>
        <article class="member-pill member-pill--admin">
          <span class="member-no"><%= idx + 1 %>.</span>

          <img
            loading="lazy"
            class="avatar avatar--sm"
            src="<%= m.avatar || 'https://via.placeholder.com/96x96?text=%20' %>"
            alt="<%= m.name %>"
          />

          <div class="member-main">
            <div class="member-name"><%= m.name %></div>
            <div class="member-meta">
              <% if (m.birth_date) { %>
                <span>Tgl lahir: <%= new Date(m.birth_date).toLocaleDateString('id-ID') %></span>
                &nbsp;•&nbsp;
              <% } %>
              <span>Dibuat: <%= new Date(m.created_at).toLocaleDateString('id-ID') %></span>
            </div>
          </div>

          <div class="member-admin-actions">
            <a href="/admin/members/<%= m.id %>/edit" class="btn btn-sm">Edit</a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</main>

<%- include('../layout-bottom', { active: 'admin' }) %>
