<div class="admin-wrap">
  <div class="admin-head">
    <h1 class="admin-title">Kelola Anggota</h1>
  </div>

  <div class="form-modern grid" style="display:grid; grid-template-columns:1.2fr .8fr; gap:18px">
    <div>
      <h3>Daftar Anggota</h3>
      <% if (!members.length) { %>
        <p class="muted">Belum ada anggota.</p>
      <% } else { %>
        <div class="grid cards">
          <% members.forEach(m => { %>
            <div class="card">
              <img src="<%= m.avatar || 'https://via.placeholder.com/960x400?text=Anggota' %>" alt="<%= m.name %>">
              <div class="pad">
                <h3><a class="rowlink" href="/admin/members/<%= m.id %>"><%= m.name %></a></h3>
                <div class="help-row">
                  <form method="post" action="/admin/members/<%= m.id %>/delete" onsubmit="return confirm('Hapus anggota ini?')">
                    <button class="btn red" type="submit">Hapus</button>
                  </form>
                  <a class="btn" href="/admin/members/<%= m.id %>">Kelola</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div>
      <h3>Tambah Anggota</h3>
      <form class="form-modern" method="post" action="/admin/members" enctype="multipart/form-data">
        <label class="label">Nama*</label>
        <input class="input" type="text" name="name" required>

        <label class="label">Bio (opsional)</label>
        <textarea class="textarea" name="bio" placeholder="Deskripsi singkat"></textarea>

        <label class="label">Foto Profil</label>
        <input class="input" type="file" name="avatar" accept="image/*">

        <div class="form-bar">
          <span class="muted">File gambar otomatis diunggah ke Cloudinary.</span>
          <button class="btn" type="submit">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>
