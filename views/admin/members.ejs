<h2>Kelola Anggota</h2>
<form method="post" enctype="multipart/form-data" class="card pad">
  <div class="form-row cols-2">
    <div><label>Nama</label><input name="name" type="text" required/></div>
    <div><label>Peran/Jabatan</label><input name="role" type="text"/></div>
  </div>
  <div class="form-row"><label>Foto</label><input name="photo" type="file" accept="image/*"/></div>
  <div class="form-row"><label>Bio</label><textarea name="bio" rows="4"></textarea></div>
  <button class="btn">Simpan</button>
</form>

<div class="grid cards" style="margin-top:16px;">
  <% (members||[]).forEach(m=>{ %>
    <div class="card">
      <img src="<%= m.photo %>" alt="<%= m.name %>"/>
      <div class="pad">
        <h3><%= m.name %></h3>
        <p class="meta"><%= m.role||'' %></p>
        <% if(m.bio){ %><p><%= m.bio %></p><% } %>
        <form method="post" action="/admin/members/<%= m.id %>/delete" onsubmit="return confirm('Hapus anggota?')">
          <button class="btn red">Hapus</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>
