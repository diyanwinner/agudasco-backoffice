<% /* ADMIN: Tambah Anggota Saja */ %>
<div class="container admin-wrap">
  <div class="admin-head" style="align-items:center; gap:12px">
    <h1 class="admin-title">Tambah Anggota</h1>

    <div style="margin-left:auto; display:flex; gap:8px; align-items:center">
      <a class="btn ghost" href="/admin">← Dashboard</a>
      <a class="btn" href="/admin/family">Kelola Data Keluarga</a>
    </div>
  </div>

  <div class="card" style="max-width:760px; margin-inline:auto">
    <form action="/admin/members" method="post" enctype="multipart/form-data" style="display:grid; gap:14px">
      <div>
        <label for="name">Nama<span style="color:#e66">*</span></label>
        <input id="name" name="name" type="text" class="input" placeholder="mis. Dedi" required>
      </div>

      <div>
        <label for="bio">Bio (opsional)</label>
        <textarea id="bio" name="bio" class="input" rows="4" placeholder="Deskripsi singkat"></textarea>
      </div>

      <div class="hint muted">
        File gambar otomatis di-upload ke Cloudinary.
      </div>

      <div>
        <label for="avatar">Foto (opsional)</label>
        <input id="avatar" name="avatar" type="file" accept="image/*" class="input">
      </div>

      <div style="display:flex; gap:8px; align-items:center; justify-content:flex-end">
        <button class="btn" type="submit">Simpan Anggota</button>
      </div>
    </form>
  </div>

  <div class="muted" style="text-align:center; margin-top:16px">
    Butuh mengisi keluarga untuk anggota yang sudah ada? → 
    <a class="rowlink" href="/admin/family">Buka Data Keluarga</a>
  </div>
</div>

<style>
  .hint{ font-size:.9rem }
</style>
