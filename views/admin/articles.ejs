<h2>Kelola Artikel</h2>
<form method="post" enctype="multipart/form-data" class="card pad">
  <div class="form-row"><label>Judul</label><input name="title" type="text" required/></div>
  <div class="form-row"><label>Gambar</label><input name="image" type="file" accept="image/*"/></div>
  <div class="form-row"><label>Konten</label><textarea name="content" rows="6"></textarea></div>
  <button class="btn">Simpan</button>
</form>

<table class="table" style="margin-top:16px">
  <tr><th>Gambar</th><th>Judul</th><th>Tanggal</th><th>Aksi</th></tr>
  <% (articles||[]).forEach(a=>{ %>
    <tr>
      <td><img src="<%= a.image %>" alt="" style="width:120px;height:70px;object-fit:cover"/></td>
      <td><a href="/artikel/<%= a.id %>" target="_blank"><%= a.title %></a></td>
      <td class="meta"><%= new Date(a.created_at).toLocaleString('id-ID') %></td>
      <td>
        <form method="post" action="/admin/articles/<%= a.id %>/delete" onsubmit="return confirm('Hapus artikel?')">
          <button class="btn red">Hapus</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>
