<%- include('../layout-top') %>

<div class="admin-wrap container">
  <div class="admin-head">
    <h1 class="admin-title">Dashboard</h1>
  </div>

  <!-- ===== Widget: Ulang Tahun 7 Hari Ke Depan ===== -->
  <div class="card mb-3">
    <div class="card-header bg-warning text-dark fw-bold">
      🎉 Ulang Tahun 7 Hari Ke Depan
    </div>
    <div class="card-body">
      <% if (upcomingBirthdays && upcomingBirthdays.length) { %>
        <ul class="list-group">
          <% upcomingBirthdays.forEach(u => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <strong><%= u.name %></strong>
                <% if (u.is_today) { %>
                  <span class="badge bg-danger ms-2">Hari ini 🎂</span>
                <% } %>
              </div>
              <span class="badge bg-primary">
                <%= new Date(u.birthdate).toLocaleDateString('id-ID', {
                    day: '2-digit',
                    month: 'long'
                }) %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-muted mb-0">Tidak ada anggota yang berulang tahun 7 hari ke depan.</p>
      <% } %>
    </div>
  </div>

  <!-- ===== Tempatkan widget admin lain di bawah ini (opsional) ===== -->
  <div class="card">
    <div class="card-header">Ringkasan</div>
    <div class="card-body">
      <p class="text-muted mb-0">Tambahkan ringkasan lain (artikel terbaru, laporan terakhir, dsb) di sini ya sayang.</p>
    </div>
  </div>
</div>

<%- include('../layout-bottom') %>
