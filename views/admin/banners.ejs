<% layout('layout') %>
<h1>Kelola Banner (Slider)</h1>

<form method="post" enctype="multipart/form-data" class="card max-480">
  <label>Gambar banner</label>
  <input type="file" name="image" accept="image/*" required/>
  <button class="btn" type="submit">Upload</button>
</form>

<h2>Daftar Banner</h2>
<div class="cards">
  <% banners.forEach(b => { %>
    <div class="card">
      <img src="<%= b.image %>" alt="banner" style="width:100%;height:140px;object-fit:cover;border-radius:8px;margin-bottom:8px">
      <div class="muted"><%= new Date(b.created_at).toLocaleString() %></div>
      <form method="post" action="/admin/banners/<%= b.id %>/delete" onsubmit="return confirm('Hapus banner ini?')">
        <button class="btn small danger" type="submit">Hapus</button>
      </form>
    </div>
  <% }) %>
</div>
