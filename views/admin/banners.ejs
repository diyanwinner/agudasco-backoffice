<% layout('layout') %>
<h2>Kelola Banner</h2>
<form method="post" enctype="multipart/form-data" class="card pad">
  <div class="form-row"><label>Gambar</label><input name="image" type="file" accept="image/*" required/></div>
  <button class="btn">Upload</button>
</form>

<div class="grid cards" style="margin-top:16px;">
  <% (banners||[]).forEach(b=>{ %>
    <div class="card">
      <img src="<%= b.image %>" alt=""/>
      <div class="pad">
        <form method="post" action="/admin/banners/<%= b.id %>/delete" onsubmit="return confirm('Hapus banner?')">
          <button class="btn red">Hapus</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>
