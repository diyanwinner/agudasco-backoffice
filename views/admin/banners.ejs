<h1>Kelola Banner</h1>
<form method="post" enctype="multipart/form-data">
  <label>Upload Banner</label>
  <input type="file" name="image" required>
  <button class="btn">Tambah</button>
</form>

<hr>
<h2>Daftar Banner</h2>
<ul>
  <% banners.forEach(b => { %>
    <li>
      <img src="<%= b.image %>" alt="banner" style="max-width:150px;">
      <form method="post" action="/admin/banners/<%= b.id %>/delete" style="display:inline">
        <button class="btn small danger">Hapus</button>
      </form>
    </li>
  <% }) %>
</ul>
