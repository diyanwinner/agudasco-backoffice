<%- include('../layout-top', { title: 'Kelola AD/ART', active: 'admin', showWhatsAppFloat: false }) %>

<div class="container py-4 form-dark">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Kelola AD/ART</h1>
    <a class="btn btn-outline-light" href="/adart" target="_blank" rel="noopener">Lihat Halaman AD/ART ↗</a>
  </div>

  <!-- Form tambah AD/ART -->
  <form class="card shadow-sm border-0 mb-4" action="/admin/adarts" method="post" enctype="multipart/form-data">
    <div class="card-body p-4">
      <div class="row g-4">
        <div class="col-lg-7">
          <div class="mb-3">
            <label class="form-label">Judul</label>
            <input name="title" class="form-control" placeholder="Judul dokumen AD/ART" required />
          </div>

          <div class="mb-3">
            <label class="form-label">URL PDF</label>
            <input name="pdf_url" class="form-control" placeholder="https://... (boleh dikosongkan jika hanya pakai cover)" />
            <div class="form-text">Bisa link Google Drive/Cloudinary/dll. Opsional.</div>
          </div>
        </div>

        <div class="col-lg-5">
          <label class="form-label">Gambar Sampul</label>
          <div class="placeholder-panel rounded-3 p-3 text-center mb-2" id="previewBox">
            <div class="opacity-75">Tarik & lepas file ke sini atau klik untuk pilih</div>
          </div>
          <input class="form-control" type="file" name="cover" accept="image/*" />
          <div class="form-text">Rasio disarankan 3:4, ukuran ≥ 600×800. File akan diupload (Cloudinary).</div>
        </div>
      </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
      <button class="btn btn-primary">Simpan</button>
    </div>
  </form>

  <!-- Daftar AD/ART -->
  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
          <thead>
            <tr>
              <th style="width:72px">#</th>
              <th>Judul</th>
              <th style="width:140px">Sampul</th>
              <th>PDF</th>
              <th style="width:120px"></th>
            </tr>
          </thead>
          <tbody>
            <% if (!adarts || adarts.length === 0) { %>
              <tr><td colspan="5" class="text-center py-4 text-secondary">Belum ada data.</td></tr>
            <% } %>
            <% adarts && adarts.forEach((a, idx) => { %>
              <tr>
                <td class="text-secondary"><%= idx + 1 %></td>
                <td><%= a.title %></td>
                <td>
                  <% if (a.cover) { %>
                    <img src="<%= a.cover %>" alt="cover" class="img-thumbnail" style="max-height:90px" />
                  <% } else { %>
                    <span class="text-secondary">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (a.pdf_url) { %>
                    <a class="link-info" href="<%= a.pdf_url %>" target="_blank" rel="noopener">Buka PDF ↗</a>
                  <% } else { %>
                    <span class="text-secondary">—</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <form action="/admin/adarts/<%= a.id %>/delete" method="post" onsubmit="return confirm('Hapus item ini?')">
                    <button class="btn btn-sm btn-outline-danger">Hapus</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  // Preview cover saat pilih file
  (function () {
    const input = document.querySelector('input[name="cover"]');
    const box   = document.getElementById('previewBox');
    if (!input || !box) return;
    input.addEventListener('change', (e) => {
      const f = e.target.files && e.target.files[0];
      if (!f) { box.innerHTML = '<div class="opacity-75">Tarik & lepas file ke sini atau klik untuk pilih</div>'; return; }
      const url = URL.createObjectURL(f);
      box.innerHTML = '<img class="img-fluid rounded" alt="preview" />';
      box.querySelector('img').src = url;
    });
  })();
</script>

<%- include('../layout-bottom', { showWhatsAppFloat: false }) %>
