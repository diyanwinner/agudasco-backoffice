<% /* Tambah data keluarga */ %>

<div class="container admin-wrap">
  <div class="admin-head" style="display:flex;align-items:center;gap:10px">
    <a class="btn ghost" href="/admin/families">← Kembali</a>
    <h1 class="admin-title" style="margin:0">Tambah Keluarga</h1>
  </div>

  <div class="card" style="padding:16px;max-width:720px">
    <form action="/admin/families" method="post" style="display:grid;gap:14px">
      <div>
        <label for="member_id">Anggota*</label>
        <select id="member_id" name="member_id" class="input" required>
          <option value="">— Pilih Anggota —</option>
          <% (members || []).forEach(m => { %>
            <option value="<%= m.id %>"><%= m.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="fullname">Nama Keluarga*</label>
        <input id="fullname" class="input" type="text" name="fullname" placeholder="mis. Novi Dwi" required />
      </div>

      <div>
        <label for="relation">Relasi</label>
        <input id="relation" class="input" type="text" name="relation" placeholder="mis. Istri / Anak" />
      </div>

      <div style="display:flex;gap:8px;justify-content:flex-end">
        <a class="btn ghost" href="/admin/families">Batal</a>
        <button class="btn" type="submit">Simpan</button>
      </div>
    </form>
  </div>
</div>
