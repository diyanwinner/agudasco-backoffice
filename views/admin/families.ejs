<%- include("../partials/admin_head", { title }) %>

<div class="container admin-wrap">
  <div class="admin-head">
    <h1 class="admin-title">Kelola Keluarga</h1>
    <a class="btn" href="/admin/families/new">+ Tambah Keluarga</a>
  </div>

  <div class="table-wrap card">
    <table class="table" style="width:100%; border-collapse:collapse">
      <thead>
        <tr>
          <th style="padding:10px; text-align:left">Anggota</th>
          <th style="padding:10px; text-align:left">Nama Keluarga</th>
          <th style="padding:10px; text-align:left">Relasi</th>
          <th style="padding:10px; text-align:left">Dibuat</th>
          <th style="padding:10px; text-align:right">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (!families.length) { %>
          <tr><td colspan="5" style="padding:12px; color:var(--muted)">Belum ada data.</td></tr>
        <% } %>
        <% families.forEach(f => { %>
          <tr style="border-top:1px solid var(--border)">
            <td style="padding:10px">
              <% if (f.member_id) { %>
                <a class="rowlink" href="/anggota/<%= f.member_id %>" target="_blank"><%= f.member_name || '—' %></a>
              <% } else { %> — <% } %>
            </td>
            <td style="padding:10px"><strong><%= f.fullname %></strong></td>
            <td style="padding:10px"><%= f.relation || '—' %></td>
            <td style="padding:10px"><%= new Date(f.created_at).toLocaleString('id-ID') %></td>
            <td style="padding:10px; text-align:right; white-space:nowrap">
              <a class="btn" href="/admin/families/<%= f.id %>">Edit</a>
              <form action="/admin/families/<%= f.id %>/delete" method="post" style="display:inline" onsubmit="return confirm('Hapus data ini?')">
                <button class="btn red" type="submit">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include("../partials/admin_foot") %>
