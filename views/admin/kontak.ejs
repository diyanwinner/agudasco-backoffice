<div class="admin-wrap">
  <div class="admin-head">
    <h1 class="admin-title">Kelola Kontak</h1>
    <a class="btn ghost" href="/kontak" target="_blank">Lihat Halaman</a>
  </div>

  <form class="card" method="post" action="/admin/kontak" style="max-width:720px">
    <div class="pad" style="display:grid; gap:12px">
      <div>
        <label class="label">Alamat</label>
        <textarea class="input" name="address" rows="4" placeholder="Tulis alamat lengkap..."><%= address %></textarea>
      </div>
      <div>
        <label class="label">Email</label>
        <input class="input" type="email" name="email" value="<%= email %>" placeholder="nama@domain.com">
      </div>
      <div>
        <label class="label">Telepon/WA</label>
        <input class="input" type="text" name="phone" value="<%= phone %>" placeholder="+62xxxxxxxxxxx">
      </div>

      <div class="form-bar">
        <span class="muted">Data disimpan ke tabel <code>site_settings</code>.</span>
        <button class="btn">Simpan</button>
      </div>
    </div>
  </form>
</div>
