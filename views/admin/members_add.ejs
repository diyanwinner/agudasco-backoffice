<%- include('../layout-top', { title: 'Tambah Anggota', active: 'admin' }) %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tambah Anggota</h1>
    <a href="/admin/members" class="btn btn-outline-secondary">← Kembali</a>
  </div>

  <form class="card shadow-sm border-0" action="/admin/members" method="post" enctype="multipart/form-data">
    <div class="card-body p-4">
      <div class="row g-4">
        <div class="col-lg-7">
          <div class="mb-3">
            <label class="form-label">Nama Lengkap</label>
            <input name="name" class="form-control" placeholder="Nama anggota" required />
          </div>

          <div class="mb-3">
            <label class="form-label">Tanggal Lahir</label>
            <input name="birthdate" type="date" class="form-control" placeholder="YYYY-MM-DD" />
            <div class="form-text">Opsional, format YYYY-MM-DD.</div>
          </div>

          <div class="mb-3">
            <label class="form-label">Bio / Keterangan</label>
            <textarea name="bio" class="form-control" rows="4" placeholder="Deskripsi singkat"></textarea>
          </div>

          <div class="mb-2">
            <label class="form-label d-block">Foto Anggota</label>
            <ul class="nav nav-pills mb-3" role="tablist">
              <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#up" type="button">Upload</button></li>
              <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#url" type="button">Pakai URL</button></li>
            </ul>
            <div class="tab-content">
              <div class="tab-pane fade show active" id="up">
                <input class="form-control" type="file" name="avatar" accept="image/*" />
                <div class="form-text">Pilih gambar (JPG/PNG/WebP).</div>
              </div>
              <div class="tab-pane fade" id="url">
                <input class="form-control" name="avatar_url" placeholder="https://..." />
                <div class="form-text">Jika keduanya diisi, yang dipakai adalah upload.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <label class="form-label">Preview Foto</label>
          <div class="border border-dashed rounded-3 p-4 text-center" id="previewBox">
            <div class="opacity-75">Belum ada gambar</div>
          </div>
        </div>
      </div>
    </div>
    <div class="card-footer d-flex gap-2 justify-content-end">
      <a href="/admin/members" class="btn btn-outline-secondary">Batal</a>
      <button class="btn btn-primary">Simpan</button>
    </div>
  </form>
</div>

<script>
  const file = document.querySelector('input[name="avatar"]');
  const box  = document.getElementById('previewBox');
  file?.addEventListener('change', (e) => {
    const f = e.target.files?.[0];
    if (!f) return (box.innerHTML = '<div class="opacity-75">Belum ada gambar</div>');
    const url = URL.createObjectURL(f);
    box.innerHTML = '<img class="img-fluid rounded" alt="preview" />';
    box.querySelector('img').src = url;
  });
</script>

<%- include('../layout-bottom') %>
