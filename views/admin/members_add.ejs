<!-- views/admin/member_add.ejs -->
<div class="admin-wrap container">
  <div class="admin-head">
    <h1 class="admin-title">Tambah Anggota</h1>
    <a href="/admin/members" class="btn ghost">← Kembali</a>
  </div>

  <div class="card">
    <div class="card-body">
      <form method="post" action="/admin/members">
        <div class="form-modern">
          <div class="form-grid-2">
            <div>
              <label class="label" for="name">Nama Lengkap</label>
              <input id="name" name="name" type="text" class="input" placeholder="Nama anggota" required />

              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px">
                <div>
                  <label class="label" for="birthdate">Tanggal Lahir</label>
                  <input id="birthdate" name="birthdate" type="date" class="input" />
                  <small class="muted">Format: YYYY-MM-DD (opsional)</small>
                </div>
                <div>
                  <label class="label" for="avatar">Foto (URL)</label>
                  <input id="avatar" name="avatar" type="url" class="input" placeholder="https://..." />
                  <small class="muted">Bisa URL Cloudinary/foto lain.</small>
                </div>
              </div>
            </div>

            <div>
              <label class="label">Preview Foto</label>
              <div class="dropzone" style="min-height:180px;cursor:auto">
                <div class="dz-empty">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2"/>
                  </svg>
                  <div class="muted">Belum ada gambar</div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-bar">
            <a href="/admin/members" class="btn ghost">Batal</a>
            <button class="btn">Simpan</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
