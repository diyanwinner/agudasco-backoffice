<h1>Kelola Laporan</h1>
<form method="post" enctype="multipart/form-data">
  <label>Judul Laporan</label>
  <input type="text" name="title" required>

  <label>Upload File (pdf, docx, xlsx)</label>
  <input type="file" name="file" required>

  <button class="btn">Tambah</button>
</form>

<hr>
<h2>Daftar Laporan</h2>
<ul>
  <% reports.forEach(r => { %>
    <li>
      <a href="<%= r.file %>" target="_blank"><%= r.title %></a>
      <form method="post" action="/admin/reports/<%= r.id %>/delete" style="display:inline">
        <button class="btn small danger">Hapus</button>
      </form>
    </li>
  <% }) %>
</ul>
