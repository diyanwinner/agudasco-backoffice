<section class="admin-wrap container">
  <header class="admin-head">
    <div>
      <h1 class="admin-title">Kelola Laporan Keuangan</h1>
      <p class="meta">Cover gambar + tautan PDF (Drive/Dropbox/S3). PDF akan <em>download langsung</em>.</p>
    </div>
    <nav class="admin-actions">
      <a class="btn ghost" href="/laporan" target="_blank" rel="noopener">Lihat Halaman Laporan ↗</a>
    </nav>
  </header>

  <form class="card form-modern" action="/admin/reports" method="post" enctype="multipart/form-data">
    <div class="form-grid-2">
      <div class="form-col">
        <label class="label">Judul</label>
        <input class="input" type="text" name="title" placeholder="Contoh: Laporan 2024–2025" required>

        <label class="label">Link PDF</label>
        <input class="input" type="text" name="pdf_url" placeholder="Tempel link Google Drive / Dropbox / S3">
        <div class="help-row">
          <span class="meta">Link Drive bentuk <code>.../file/d/ID/view</code> akan otomatis jadi direct download.</span>
        </div>
      </div>

      <div class="form-col">
        <label class="label">Cover</label>
        <div id="dzReport" class="dropzone">
          <div class="dz-preview"><img id="imgReport"/><button type="button" class="dz-remove" id="rmReport">✕</button></div>
          <div class="dz-empty">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M4 17v2a1 1 0 0 0 1 1h14M4 17l4-4 3 3 5-5 4 4M4 17V7a1 1 0 0 1 1-1h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div>Tarik & letakkan cover ke sini</div>
            <small class="meta">atau klik untuk pilih file</small>
          </div>
          <input id="coverInput" type="file" name="cover" accept="image/*" hidden>
        </div>
      </div>
    </div>

    <div class="form-bar">
      <div class="left meta"></div>
      <div class="right"><button class="btn" type="submit">Simpan</button></div>
    </div>
  </form>

  <h2 style="margin:26px 0 12px">Laporan Saat Ini</h2>
  <div class="table-wrap card">
    <table class="table">
      <thead>
        <tr>
          <th style="width:110px">Cover</th>
          <th>Judul</th>
          <th style="width:240px">PDF</th>
          <th style="width:140px">Tanggal</th>
          <th style="width:110px">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% (reports||[]).forEach(r=>{ %>
          <tr>
            <td><img src="<%= r.cover || 'https://via.placeholder.com/110x70?text=COVER' %>" alt="" style="width:100px;height:64px;object-fit:cover;border-radius:8px"></td>
            <td><a class="rowlink" href="/laporan/<%= r.id %>" target="_blank"><%= r.title %></a></td>
            <td class="meta">
              <% if (r.pdf_url) { %>
                <a href="<%= r.pdf_url %>" target="_blank" rel="noopener">Unduh PDF ↗</a>
              <% } else { %>
                <span class="meta">Belum ada</span>
              <% } %>
            </td>
            <td class="meta"><%= new Date(r.created_at).toLocaleString('id-ID') %></td>
            <td>
              <form action="/admin/reports/<%= r.id %>/delete" method="post" onsubmit="return confirm('Hapus laporan ini?')">
                <button class="btn red" type="submit">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (!(reports||[]).length) { %>
          <tr><td colspan="5" class="meta">Belum ada laporan.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<script>
(function() {
  const dz = document.getElementById('dzReport');
  const i  = document.getElementById('coverInput');
  const pv = dz.querySelector('.dz-preview'); const im = document.getElementById('imgReport');
  const rm = document.getElementById('rmReport'); const emp = dz.querySelector('.dz-empty');
  const show = f => { im.src = URL.createObjectURL(f); pv.style.display='block'; emp.style.display='none'; };
  const clear=()=>{ i.value=''; im.src=''; pv.style.display='none'; emp.style.display='flex'; };
  rm.addEventListener('click', clear);
  dz.addEventListener('click', ()=>i.click());
  i.addEventListener('change', e=>{ const f=e.target.files?.[0]; if(f) show(f); });
  dz.addEventListener('dragover', e=>{ e.preventDefault(); dz.classList.add('is-drag'); });
  dz.addEventListener('dragleave', ()=>dz.classList.remove('is-drag'));
  dz.addEventListener('drop', e=>{ e.preventDefault(); dz.classList.remove('is-drag'); const f=e.dataTransfer.files?.[0]; if(f&&f.type.startsWith('image/')){ i.files=e.dataTransfer.files; show(f);} });
})();
</script>
