<!-- views/admin/reports.ejs -->

<h1>Kelola Laporan</h1>

<form class="card" action="/admin/reports" method="post" enctype="multipart/form-data">
  <div class="grid">
    <label>
      Judul Laporan
      <input type="text" name="title" placeholder="Contoh: Laporan Keuangan Q3 2025" required />
    </label>

    <label>
      Upload File (pdf, docx, xlsx)
      <input
        type="file"
        name="file"
        accept=".pdf,.doc,.docx,.xls,.xlsx,.xlsm"
        required
      />
    </label>
  </div>

  <div style="margin-top:12px">
    <button class="btn">Upload</button>
  </div>
</form>

<h2 class="section-title">Daftar Laporan</h2>

<% if (!reports || reports.length === 0) { %>
  <div class="muted">Belum ada laporan yang diunggah.</div>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th style="width:48px">#</th>
        <th>Judul</th>
        <th>File</th>
        <th>Tanggal</th>
        <th style="width:120px">Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% reports.forEach((r, idx) => { %>
        <tr>
          <td><%= idx + 1 %></td>
          <td><%= r.title %></td>
          <td>
            <% if (r.file) { %>
              <a href="<%= r.file %>" target="_blank" rel="noopener">Lihat / Unduh</a>
            <% } else { %>
              <span class="muted">–</span>
            <% } %>
          </td>
          <td><%= new Date(r.created_at).toLocaleString() %></td>
          <td>
            <form action="/admin/reports/<%= r.id %>/delete" method="post" onsubmit="return confirm('Hapus laporan ini?')">
              <button class="btn danger small">Hapus</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
