<% /* FAMILY LIST (GRID + image fallback) */ %>
<div class="container admin-wrap">
  <div class="admin-head">
    <h1 class="admin-title"><%= title || 'Data Keluarga' %></h1>
  </div>

  <% // selectedMemberId fallback aman
     const selId = (typeof selectedMemberId !== 'undefined' && selectedMemberId !== null && selectedMemberId !== false)
       ? String(selectedMemberId) : "";
  %>

  <!-- Filter + cari -->
  <div class="card" style="padding:12px; display:flex; gap:12px; align-items:center; flex-wrap:wrap">
    <form method="get" action="/admin/family" style="display:flex; gap:10px; align-items:center">
      <label for="member_id" style="margin-right:6px">Filter Anggota</label>
      <select id="member_id" name="member_id" onchange="this.form.submit()" class="input" style="min-width:220px">
        <option value="">— Semua Anggota —</option>
        <% (members || []).forEach(m => { %>
          <option value="<%= m.id %>" <%= String(m.id) === selId ? "selected" : "" %>><%= m.name %></option>
        <% }) %>
      </select>
      <% if (selId) { %><a class="btn ghost" href="/admin/family">Reset</a><% } %>
    </form>

    <div style="margin-left:auto; display:flex; gap:8px; align-items:center">
      <label for="textFilter" class="muted">Cari</label>
      <input id="textFilter" class="input" type="text"
             placeholder="ketik nama anggota/keluarga/relasi…" style="min-width:280px">
    </div>
  </div>

  <% /* Group keluarga per member */ %>
  <%
    const famMap = {};
    (families || []).forEach(f => {
      const mid = Number(f.member_id);
      (famMap[mid] ||= []).push(f);
    });
    const list = (members || []).filter(m => !selId || String(m.id) === selId);
    const placeholder = 'https://via.placeholder.com/600x600.png?text=Foto';
  %>

  <!-- GRID (wrap ke bawah) -->
  <div class="card-grid">
    <% list.forEach(m => { 
         const fams = famMap[Number(m.id)] || [];
         const raw = (m.avatar || '').trim();
         // pilih src awal: hanya pakai yang mulai dengan http(s), selain itu anggap kosong
         const initialSrc = (/^https?:\/\//i.test(raw) ? raw : '') || placeholder;
         const searchBlob = (m.name + ' ' + fams.map(x => (x.fullname||'') + ' ' + (x.relation||'')).join(' ')).toLowerCase();
    %>
      <div class="mini-card" data-search="<%= searchBlob %>">
        <div class="img-wrap">
          <img
            loading="lazy"
            src="<%= initialSrc %>"
            alt="<%= m.name %>"
            onerror="this.onerror=null; this.src='<%= placeholder %>';">
        </div>

        <div class="mini-name"><%= m.name %></div>

        <ul class="mini-fam">
          <% if (fams.length === 0) { %>
            <li class="muted">Belum ada data keluarga</li>
          <% } else { %>
            <% fams.slice(0,3).forEach(f => { %>
              <li><strong><%= f.fullname %></strong> <span class="muted">(<%= f.relation || '—' %>)</span></li>
            <% }) %>
            <% if (fams.length > 3) { %>
              <li class="muted">+<%= fams.length - 3 %> lainnya</li>
            <% } %>
          <% } %>
        </ul>

        <a class="btn w-full" href="/admin/members/<%= m.id %>">Detail</a>
      </div>
    <% }) %>
  </div>
</div>

<style>
  .card-grid{
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(180px,1fr));
    gap:12px;
    margin-top:12px;
  }
  .mini-card{
    border:1px solid var(--border);
    border-radius:16px;
    background:var(--card-bg, rgba(255,255,255,.03));
    padding:10px;
    box-shadow:var(--shadow-sm, 0 1px 2px rgba(0,0,0,.15));
    display:flex; flex-direction:column; gap:8px;
  }
  .img-wrap{
    width:100%;
    aspect-ratio: 1 / 1;
    border-radius:12px;
    overflow:hidden;
    background:#0e0e0e;
  }
  .img-wrap img{
    width:100%; height:100%;
    object-fit:cover; display:block;
  }
  .mini-name{ font-weight:700; line-height:1.2 }
  .mini-fam{ list-style:disc; margin:0 0 6px 16px; padding:0 }
  .w-full{ width:100%; text-align:center }
</style>

<script>
  // Filter teks untuk card
  (function () {
    const input = document.getElementById('textFilter');
    const cards = Array.from(document.querySelectorAll('.mini-card'));
    if (!input || !cards.length) return;
    input.addEventListener('input', function () {
      const q = input.value.trim().toLowerCase();
      cards.forEach(c => {
        const t = c.getAttribute('data-search') || '';
        c.style.display = t.includes(q) ? '' : 'none';
      });
    });
  })();
</script>
