<div class="container admin-wrap">
  <div class="admin-head">
    <h1 class="admin-title"><%= title || "Data Keluarga Anggota" %></h1>

    <form action="/admin/family" method="get" class="flex gap-2 items-center">
      <select name="member_id" onchange="this.form.submit()" class="input" style="min-width:200px">
        <option value="">— Semua Anggota —</option>
        <% (members || []).forEach(m => { %>
          <option value="<%= m.id %>" <%= String(m.id) === String(selectedMemberId || "") ? "selected" : "" %>>
            <%= m.name %>
          </option>
        <% }) %>
      </select>
      <% if (selectedMemberId) { %>
        <a href="/admin/family" class="btn gray">Reset</a>
      <% } %>
    </form>
  </div>

  <!-- Form tambah keluarga -->
  <div class="card mb-3">
    <h2 class="h5 mb-2">Tambah Keluarga</h2>
    <form action="/admin/family" method="post" class="flex gap-2 flex-wrap">
      <div style="flex:1; min-width:180px">
        <label>Anggota</label>
        <select name="member_id" required class="input">
          <option value="">Pilih...</option>
          <% (members || []).forEach(m => { %>
            <option value="<%= m.id %>"><%= m.name %></option>
          <% }) %>
        </select>
      </div>
      <div style="flex:1; min-width:180px">
        <label>Nama Keluarga</label>
        <input type="text" name="fullname" class="input" required placeholder="Nama Lengkap" />
      </div>
      <div style="flex:1; min-width:180px">
        <label>Relasi</label>
        <input type="text" name="relation" class="input" placeholder="Contoh: Istri, Anak, Suami" />
      </div>
      <div class="flex items-end">
        <button class="btn primary" type="submit">+ Tambah</button>
      </div>
    </form>
  </div>

  <!-- Tabel keluarga -->
  <div class="card table-wrap">
    <table class="table" style="width:100%; border-collapse:collapse;">
      <thead>
        <tr>
          <th style="padding:10px; text-align:left">Anggota</th>
          <th style="padding:10px; text-align:left">Nama Keluarga</th>
          <th style="padding:10px; text-align:left">Relasi</th>
          <th style="padding:10px; text-align:right">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (!families || !families.length) { %>
          <tr>
            <td colspan="4" style="padding:12px; color:var(--muted)">Belum ada data keluarga.</td>
          </tr>
        <% } %>
        <% (families || []).forEach(f => { %>
          <tr style="border-top:1px solid var(--border)">
            <td style="padding:10px">
              <% if (f.member_id) { %>
                <a href="/anggota/<%= f.member_id %>" target="_blank"><%= f.member_name %></a>
              <% } else { %> — <% } %>
            </td>
            <td style="padding:10px"><strong><%= f.fullname %></strong></td>
            <td style="padding:10px"><%= f.relation || "—" %></td>
            <td style="padding:10px; text-align:right; white-space:nowrap">
              <form action="/admin/family/<%= f.id %>/delete" method="post" style="display:inline"
                    onsubmit="return confirm('Yakin hapus data ini?')">
                <button class="btn red" type="submit">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
