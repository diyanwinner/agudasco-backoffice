<% /* Edit data keluarga */ %>

<div class="container admin-wrap">
  <div class="admin-head" style="display:flex;align-items:center;gap:10px">
    <a class="btn ghost" href="/admin/families">← Kembali</a>
    <h1 class="admin-title" style="margin:0">Edit Keluarga</h1>
  </div>

  <div class="card" style="padding:16px;max-width:720px">
    <form action="/admin/families/<%= family.id %>" method="post" style="display:grid;gap:14px">
      <div>
        <label for="member_id">Anggota*</label>
        <select id="member_id" name="member_id" class="input" required>
          <% (members || []).forEach(m => { %>
            <option value="<%= m.id %>" <%= m.id === family.member_id ? 'selected' : '' %>><%= m.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="fullname">Nama Keluarga*</label>
        <input id="fullname" class="input" type="text" name="fullname" value="<%= family.fullname %>" required />
      </div>

      <div>
        <label for="relation">Relasi</label>
        <input id="relation" class="input" type="text" name="relation" value="<%= family.relation || '' %>" />
      </div>

      <div style="display:flex;gap:8px;justify-content:space-between;align-items:center">
        <form action="/admin/families/<%= family.id %>/delete" method="post" onsubmit="return confirm('Hapus data ini?')">
          <button class="btn red" type="submit">Hapus</button>
        </form>

        <div style="display:flex;gap:8px">
          <a class="btn ghost" href="/admin/families">Batal</a>
          <button class="btn" type="submit">Simpan Perubahan</button>
        </div>
      </div>
    </form>
  </div>
</div>
