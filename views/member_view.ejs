<main>
  <div class="container">

    <!-- Aksi halaman -->
    <div class="page-actions" style="margin:8px 0 12px">
      <a class="btn ghost back"
         href="/anggota"
         onclick="if (history.length > 1) { history.back(); return false; }">
        ← Kembali
      </a>
    </div>

    <!-- Judul -->
    <div class="section-head">
      <h1 style="margin:0"><%= member.name %></h1>
      <% if ((member.bio||'').trim()) { %>
        <div class="muted"><%= member.bio %></div>
      <% } %>
    </div>

    <!-- Foto profil (ukuran moderat, tidak memenuhi layar) -->
    <figure class="media-preview member" style="margin-top:12px;">
      <img
        class="media-fit"
        src="<%= member.avatar || 'https://via.placeholder.com/960x540?text=Foto' %>"
        alt="<%= member.name %>"
        style="max-height:360px; object-fit:cover;"
      />
      <figcaption class="hero-caption">Anggota</figcaption>
    </figure>

  </div>
</main>
