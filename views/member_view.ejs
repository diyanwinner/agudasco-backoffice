<main>
  <div class="container">

    <!-- Judul -->
    <div class="section-head">
      <h1><%= member.name %></h1>
      <% if ((member.bio||'').trim()) { %>
        <div class="muted"><%= member.bio %></div>
      <% } %>
    </div>

    <!-- Foto header: ukuran moderat -->
    <figure class="media-preview member">
      <img class="media-fit"
           src="<%= member.avatar || 'https://via.placeholder.com/960x540?text=Foto' %>"
           alt="<%= member.name %>"/>
      <figcaption class="hero-caption">Anggota</figcaption>
    </figure>

    <!-- 2 kolom: Keluarga | Galeri -->
    <section class="grid grid--2">
      <div>
        <h2>Keluarga</h2>
        <% if ((families||[]).length === 0) { %>
          <p class="muted">Belum ada data keluarga.</p>
        <% } else { %>
          <ul class="fam-list">
            <% families.forEach(f => { %>
              <li>
                <strong><%= f.fullname %></strong>
                <% if ((f.relation||'').trim()) { %>
                  <span class="muted">(<%= f.relation %>)</span>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>

      <div>
        <h2>Galeri</h2>
        <% if ((photos||[]).length === 0) { %>
          <p class="muted">Belum ada foto.</p>
        <% } else { %>
          <div class="photo-grid">
            <% photos.forEach(p => { %>
              <a href="<%= p.image_url %>"
                 onclick="openLightbox('<%= p.image_url %>','<%= p.caption||'' %>'); return false;">
                <img loading="lazy" src="<%= p.image_url %>" alt="<%= p.caption||member.name %>"/>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
  </div>
</main>
