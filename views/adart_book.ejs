<%- include('layout-top', { title: 'AD/ART (Flipbook)', active: 'adart' }) %>

<div class="container py-4">
  <div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">AD/ART — Mode Flipbook</h1>
    <a href="/adart" class="btn btn-outline-light btn-sm ms-auto">Mode Scroll</a>
    <!-- tombol Mode Zoom disisipkan via JS -->
  </div>

  <div class="card border-0 form-dark">
    <div class="card-body">
      <div id="flipbook" class="mx-auto" style="width:920px;max-width:100%;height:620px"></div>

      <div id="hint" class="text-secondary small mt-3">
        Memuat pratinjau cepat… versi tajam akan muncul otomatis.
      </div>
      <div id="errBox" class="text-danger small mt-2" style="display:none;"></div>

      <p class="text-center small text-secondary mt-2 mb-0">
        Sumber file: <code>/docs/adart.pdf</code>
      </p>
    </div>
  </div>
</div>

<!-- ============ CSS (local vendor) ============ -->
<link rel="stylesheet" href="/public/vendor/stPageFlip.min.css" />

<!-- ============ PDF.js ============ -->
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
</script>

<!-- ============ PageFlip (local + fallback) ============ -->
<script src="/public/vendor/page-flip.browser.min.js"></script>
<script>
(function ensureFlip(){
  if (window.PageFlip || (window.St && window.St.PageFlip)) return;
  const s=document.createElement('script');
  s.src='https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js';
  document.head.appendChild(s);
})();
</script>

<!-- ============ MAIN ============ -->
<script>
(async () => {
  const pdfUrl = '/docs/adart.pdf';
  const el = document.getElementById('flipbook');
  const errBox = document.getElementById('errBox');
  const hint = document.getElementById('hint');
  const showErr = (m)=>{ errBox.style.display='block'; errBox.textContent=m };

  // --- deteksi perangkat & jaringan ---
  const isPhone = matchMedia('(max-width: 576px)').matches;
  const net = navigator.connection || {};
  const saveData = !!net.saveData;
  const down = net.downlink || 0;

  // DPR dibatasi agar tidak meledak
  const DPR = Math.min(window.devicePixelRatio || 1, saveData ? 1.5 : 3);

  // Target tinggi untuk preview & final (px) — adaptif
  const H_PREVIEW =
    saveData ? 900 :
    isPhone ? (down >= 2.5 ? 1200 : 1000) :
    1200;

  const H_FINAL =
    saveData ? 1400 :
    isPhone ? (down >= 2.5 ? 1800 : 1500) :
    2100;

  // --- util render pdf -> dataURL ---
  async function renderPdfToImages(pdf, targetH, usePng) {
    const imgs = [];
    // batasi concurrency = 1 agar RAM aman di HP
    for (let p = 1; p <= pdf.numPages; p++) {
      const page = await pdf.getPage(p);
      const vp0 = page.getViewport({ scale: 1 });
      const scale = (targetH / vp0.height) * DPR;
      const vp = page.getViewport({ scale });

      const c = document.createElement('canvas');
      const ctx = c.getContext('2d', { willReadFrequently: false });

      c.width = Math.ceil(vp.width);
      c.height = Math.ceil(vp.height);

      await page.render({ canvasContext: ctx, viewport: vp }).promise;

      // HP pakai JPEG agar file kecil → lebih cepat; Desktop boleh PNG
      const url = usePng ? c.toDataURL('image/png')
                         : c.toDataURL('image/jpeg', 0.86);
      imgs.push(url);

      // beri napas ke UI
      await new Promise(r => requestAnimationFrame(r));
    }
    return imgs;
  }

  // --- load PDF ---
  let pdf;
  try {
    pdf = await pdfjsLib.getDocument(pdfUrl).promise;
  } catch(e) {
    return showErr('Gagal memuat PDF. Pastikan /docs/adart.pdf tersedia.');
  }

  // --- siapkan PageFlip ---
  function getFlipCtor(){ return window.PageFlip || (window.St && window.St.PageFlip) || null; }
  for (let i=0;i<30 && !getFlipCtor();i++) { await new Promise(r=>setTimeout(r,100)); }
  const Flip = getFlipCtor();
  if (!Flip) return showErr('Library PageFlip tidak ter-load. Coba refresh (Ctrl+F5).');

  const singlePage = isPhone;
  const pageW = singlePage ? 500 : 660;
  const pageH = singlePage ? 820 : 900;

  const flip = new Flip(el, {
    width: pageW, height: pageH,
    size: 'stretch',
    showCover: true,
    mobileScrollSupport: true,
    maxShadowOpacity: 0.25,
    minWidth: 320, minHeight: 480,
    useMouseEvents: true,
  });

  // --- fase 1: PRATINJAU CEPAT ---
  try {
    const previewImages = await renderPdfToImages(pdf, H_PREVIEW, /*usePng*/ false);
    flip.loadFromImages(previewImages);
  } catch(e) {
    console.error(e);
    return showErr('Gagal membuat pratinjau.');
  }

  // tambahkan tombol zoom ke pdf asli
  const zoomBtn = document.createElement('a');
  zoomBtn.href = pdfUrl;
  zoomBtn.target = '_blank';
  zoomBtn.rel = 'noopener';
  zoomBtn.className = 'btn btn-outline-light btn-sm';
  zoomBtn.textContent = 'Mode Zoom';
  document.querySelector('.d-flex.align-items-center.gap-2.mb-3')?.appendChild(zoomBtn);

  // keyboard (desktop)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  flip.flipPrev();
    if (e.key === 'ArrowRight') flip.flipNext();
  });

  // responsive
  const onResize = () => {
    const w = el.clientWidth || pageW;
    const ratio = pageH / pageW;
    flip.update({ width: w, height: Math.round(w * ratio) });
  };
  addEventListener('resize', onResize, { passive: true });
  setTimeout(onResize, 0);

  // --- fase 2: VERSI TAJAM (background), timeout 25s ---
  const abort = new AbortController();
  const t = setTimeout(() => abort.abort(), 25000);

  try {
    // jika hemat data / jaringan lambat, skip upgrade biar cepat
    const shouldUpgrade = !saveData && (down >= 1.2 || !isPhone);
    if (shouldUpgrade) {
      const hdImages = await renderPdfToImages(pdf, H_FINAL, /*usePng*/ !isPhone);
      // swap dataset ke HD
      flip.loadFromImages(hdImages);
      hint.textContent = 'Mode tajam aktif. Ketuk untuk membalik halaman.';
    } else {
      hint.textContent = 'Mode hemat data aktif.';
    }
  } catch(e) {
    console.warn('Upgrade ke HD dibatalkan/timeout:', e?.message || e);
    hint.textContent = 'Pratinjau cepat digunakan.';
  } finally {
    clearTimeout(t);
  }

})();
</script>

<style>
  .form-dark .page { background:#0f172a; }
  #flipbook .page img{ width:100%; height:100%; object-fit:contain; image-rendering:auto; }
  @media (max-width:576px){
    .container{ padding-left:.5rem; padding-right:.5rem; }
    #flipbook{ height:72vh !important; }
  }
</style>

<%- include('layout-bottom') %>
