<%- include('layout-top', { title: 'AD/ART (Flipbook)', active: 'adart' }) %>

<div class="container-fluid py-3">
  <div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">AD/ART — Mode Flipbook</h1>
    <a href="/adart" class="btn btn-outline-light btn-sm ms-auto d-none d-md-inline">Mode Scroll</a>
  </div>

  <div class="card border-0 form-dark">
    <div class="card-body p-2">
      <div id="flipbook" class="mx-auto" style="max-width:1000px; width:100%; height:70vh;"></div>
      <div id="errBox" class="alert alert-danger mt-3 py-2 px-3 small" style="display:none"></div>
      <p class="text-center small text-secondary mt-2">
        Sumber file: <code>/docs/adart.pdf</code>
      </p>
    </div>
  </div>
</div>

<!-- ===== CSS Flipbook ===== -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/css/stpageflip.min.css">

<!-- ===== PDF.js ===== -->
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>
  // Worker PDF.js
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    "https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js";
</script>

<script>
/** Util: muat <script> dari URL dan tunggu selesai */
function loadScriptOnce(src) {
  return new Promise((resolve, reject) => {
    // kalau sudah ada tag yang sama, sukseskan saja
    if ([...document.scripts].some(s => s.src === src)) return resolve();
    const s = document.createElement('script');
    s.src = src;
    s.async = true;
    s.onload = () => resolve();
    s.onerror = () => reject(new Error('Fail load ' + src));
    document.head.appendChild(s);
  });
}

/** Muat PageFlip dari banyak CDN sampai berhasil */
async function ensurePageFlip() {
  const urls = [
    // 1) jsDelivr (utama)
    "https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/js/stpageflip.min.js",
    // 2) unpkg (fallback)
    "https://unpkg.com/st-pageflip@2.0.7/dist/js/stpageflip.min.js",
    // 3) alternatif paket lama (sebagian CDN)
    "https://cdn.jsdelivr.net/npm/page-flip@1.2.2/dist/js/page-flip.browser.min.js"
  ];

  for (const u of urls) {
    try {
      await loadScriptOnce(u);
      if (window.St?.PageFlip || window.PageFlip) return true;
    } catch (_) { /* lanjut ke CDN lain */ }
  }
  return false;
}

(function(){
  const errBox = document.getElementById('errBox');
  const showErr = (msg) => { errBox.style.display='block'; errBox.textContent = msg; console.error(msg); };

  (async () => {
    const pdfUrl = "/docs/adart.pdf";
    console.log("[ADART] mulai load PDF:", pdfUrl);

    // 1) Muat PageFlip dulu (multi-CDN)
    const okFlip = await ensurePageFlip();
    if (!okFlip) {
      showErr("❌ Library PageFlip tidak ter-load. Coba refresh (Ctrl+F5).");
      return;
    }

    // 2) Ambil PDF
    let pdf;
    try {
      pdf = await pdfjsLib.getDocument(pdfUrl).promise;
    } catch (e) {
      showErr("❌ Tidak bisa memuat PDF: " + e.message);
      return;
    }
    console.log("[ADART] halaman PDF:", pdf.numPages);

    // 3) Render semua halaman jadi image
    const images = [];
    try {
      for (let p = 1; p <= pdf.numPages; p++) {
        const page = await pdf.getPage(p);
        const base = page.getViewport({ scale: 1 });
        const targetH = 1200; // resolusi internal bagus
        const scale = targetH / base.height;
        const vp = page.getViewport({ scale });

        const c = document.createElement('canvas');
        c.width  = Math.ceil(vp.width);
        c.height = Math.ceil(vp.height);
        await page.render({ canvasContext: c.getContext('2d'), viewport: vp }).promise;
        const url = c.toDataURL('image/jpeg', 0.92);
        images.push(url);
        if (p === 1) console.log("[ADART] sample image length:", url.length);
      }
    } catch (e) {
      showErr("❌ Gagal merender halaman PDF: " + e.message);
      return;
    }

    if (!images.length) {
      showErr("❌ Tidak ada halaman yang dirender dari PDF.");
      return;
    }

    // 4) Inisialisasi Flipbook
    const FlipCtor = window.PageFlip || (window.St && window.St.PageFlip);
    const el = document.getElementById('flipbook');

    // ukuran default 1 halaman; 'size:stretch' akan menyesuaikan container
    const flip = new FlipCtor(el, {
      width: 600,
      height: 850,
      size: "stretch",
      showCover: true,
      autoSize: true,
      mobileScrollSupport: true,
      maxShadowOpacity: 0.3,
      useMouseEvents: true
    });

    flip.loadFromImages(images);

    // keyboard
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft')  flip.flipPrev();
      if (e.key === 'ArrowRight') flip.flipNext();
    });

    // responsif: jaga tinggi kontainer
    const fit = () => {
      const vh = Math.max(window.innerHeight, document.documentElement.clientHeight);
      el.style.height = Math.max(500, vh - 180) + "px";
    };
    fit();
    window.addEventListener('resize', fit, { passive: true });
  })();
})();
</script>

<style>
  body { overflow-x: hidden; }
  #flipbook { outline: none; }
  .form-dark .page { background:#0f172a; }
  #flipbook .page img { width:100%; height:100%; object-fit:contain; }
</style>

