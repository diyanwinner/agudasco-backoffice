<%- include('layout-top', { title: 'AD/ART (Flipbook)', active: 'adart' }) %>

<div class="container py-4">
  <div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">AD/ART — Mode Flipbook</h1>
    <a href="/adart" class="btn btn-outline-light btn-sm ms-auto">Mode Scroll</a>
  </div>

  <div class="card border-0 form-dark">
    <div class="card-body">
      <div id="flipbook" class="mx-auto" style="width:960px;max-width:100%;height:620px"></div>
      <div id="errBox" class="text-danger small mt-3" style="display:none"></div>
      <p class="text-center small text-secondary mt-2">Sumber file: <code>/docs/adart.pdf</code></p>
    </div>
  </div>
</div>

<link rel="stylesheet" href="/public/vendor/stPageFlip.min.css" />

<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js'</script>

<script src="/public/vendor/page-flip.browser.min.js"></script>

<script>
(async () => {
  const pdfUrl = '/docs/adart.pdf';
  const el = document.getElementById('flipbook');
  const errBox = document.getElementById('errBox');
  const showErr = (m)=>{errBox.style.display='block'; errBox.textContent=m};

  // === 1) Render tajam untuk mobile (pakai DPR & PNG) ===
  const DPR = Math.min(window.devicePixelRatio || 1, 3); // batasi max 3x biar nggak berat
  const isPhone = window.matchMedia('(max-width: 576px)').matches;

  let pdf;
  try {
    pdf = await pdfjsLib.getDocument(pdfUrl).promise;
    console.log('[ADART] mulai load PDF:', pdfUrl);
  } catch (e) {
    return showErr('Gagal memuat PDF. Pastikan /docs/adart.pdf ada.');
  }

  const images = [];
  try {
    for (let p = 1; p <= pdf.numPages; p++) {
      const page = await pdf.getPage(p);

      // target tinggi lebih besar + DPR untuk ketajaman
      const baseVp  = page.getViewport({ scale: 1 });
      const targetH = 1600; // dasar
      const scale   = (targetH / baseVp.height) * DPR;

      const vp = page.getViewport({ scale });
      const c  = document.createElement('canvas');
      const ctx = c.getContext('2d');

      // resolusi fisik = * DPR
      c.width  = Math.ceil(vp.width);
      c.height = Math.ceil(vp.height);

      await page.render({ canvasContext: ctx, viewport: vp }).promise;

      // PNG (lossless) -> teks bening
      images.push(c.toDataURL('image/png'));
    }
  } catch (e) {
    console.error(e);
    return showErr('Gagal merender halaman PDF.');
  }

  // === 2) Inisialisasi PageFlip ===
  // Single page di HP agar huruf besar; spread di layar lebar
  const singlePage = isPhone;
  const pageWidth  = singlePage ? 420 : 600;  // ukuran 1 halaman
  const pageHeight = singlePage ? 700 : 800;

  const Flip = (window.PageFlip || (window.St && window.St.PageFlip));
  if (!Flip) return showErr('Library PageFlip tidak ter-load. Coba refresh (Ctrl+F5).');

  const flip = new Flip(el, {
    width: pageWidth,
    height: pageHeight,
    size: 'stretch',
    showCover: true,
    mobileScrollSupport: true,
    maxShadowOpacity: 0.25,
    // batasi auto single/dual:
    minWidth: 320,  minHeight: 480,
    useMouseEvents: true,
    // paksa mode single di HP
    renderControlButtons: false,
    startPage: 0
  });

  // force single page on phone
  if (singlePage && flip.turn) {
    try { flip.update({ width: pageWidth, height: pageHeight }); } catch {}
  }

  flip.loadFromImages(images);

  // Navigasi keyboard (opsional)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  flip.flipPrev();
    if (e.key === 'ArrowRight') flip.flipNext();
  });

  // Responsif: setelah resize, sesuaikan tinggi
  const onResize = () => {
    const w = el.clientWidth || pageWidth;
    const ratio = pageHeight / pageWidth;
    const h = Math.round(w * ratio);
    flip.update({ width: w, height: h });
  };
  window.addEventListener('resize', onResize, { passive: true });
  setTimeout(onResize, 0);
})();
</script>

<style>
  .form-dark .page { background:#0f172a; }
  #flipbook .page img{ width:100%; height:100%; object-fit:contain; image-rendering:auto; }
  /* sedikit kurangi padding di HP agar area baca lebih besar */
  @media (max-width:576px){
    .container { padding-left:.5rem; padding-right:.5rem; }
    #flipbook{ height:70vh !important; }
  }
</style>

<%- include('layout-bottom') %>
