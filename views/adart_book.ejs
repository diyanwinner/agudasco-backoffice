<%- include('layout-top', { title: 'AD/ART (Flipbook)', active: 'adart' }) %>

<div class="container-fluid py-3">
  <div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">AD/ART — Mode Flipbook</h1>
    <a href="/adart" class="btn btn-outline-light btn-sm ms-auto d-none d-md-inline">Mode Scroll</a>
  </div>

  <div class="card border-0 form-dark">
    <div class="card-body p-2">
      <div id="flipbook" class="mx-auto"></div>
      <div id="errBox" class="text-danger small mt-3" style="display:none"></div>
      <p class="text-center small text-secondary mt-2">
        Sumber file: <code>/docs/adart.pdf</code>
      </p>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/css/stpageflip.min.css">
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    "https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js";
</script>
<script src="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/js/stpageflip.min.js"></script>

<script>
(async () => {
  const errBox = document.getElementById("errBox");
  const showErr = (msg) => { errBox.style.display = "block"; errBox.textContent = msg; console.error(msg); };

  // pastikan file ini benar2 ada: /public/docs/adart.pdf juga boleh dipakai
  const pdfUrl = "/docs/adart.pdf";

  console.log("[ADART] mulai load PDF:", pdfUrl);
  let pdf;
  try {
    pdf = await pdfjsLib.getDocument(pdfUrl).promise;
  } catch (e) {
    return showErr("❌ Tidak bisa memuat PDF: " + e.message);
  }
  console.log("[ADART] halaman PDF:", pdf.numPages);

  const imgs = [];
  try {
    for (let i = 1; i <= pdf.numPages; i++) {
      const page = await pdf.getPage(i);
      const base = page.getViewport({ scale: 1 });
      const targetH = 1200;
      const scale = targetH / base.height;
      const vp = page.getViewport({ scale });

      const canvas = document.createElement("canvas");
      canvas.width = Math.ceil(vp.width);
      canvas.height = Math.ceil(vp.height);
      await page.render({ canvasContext: canvas.getContext("2d"), viewport: vp }).promise;
      const url = canvas.toDataURL("image/jpeg", 0.92);
      imgs.push(url);
      // log 1 saja untuk verifikasi
      if (i === 1) console.log("[ADART] sample image length:", url.length);
    }
  } catch (e) {
    return showErr("❌ Gagal merender halaman PDF: " + e.message);
  }

  if (!imgs.length) return showErr("❌ Tidak ada halaman yang dirender dari PDF.");

  const FlipCtor = window.PageFlip || (window.St && window.St.PageFlip);
  if (!FlipCtor) return showErr("❌ Library PageFlip tidak ter-load. Coba refresh (Ctrl+F5).");

  const el = document.getElementById("flipbook");
  // ukuran 1 halaman; tinggi mengikuti layar
  const pageWidth = 600;
  const pageHeight = 850;

  // set ukuran kontainer lewat JS + CSS var supaya responsif
  const vh = Math.max(window.innerHeight, document.documentElement.clientHeight);
  const availableH = Math.max(500, vh - 180); // header & padding
  el.style.width = "min(100%, 1000px)";
  el.style.height = availableH + "px";

  const flip = new FlipCtor(el, {
    width: pageWidth,
    height: pageHeight,
    size: "stretch",
    showCover: true,
    autoSize: true,
    mobileScrollSupport: true,
    maxShadowOpacity: 0.3,
    useMouseEvents: true,
  });

  console.log("[ADART] loadFromImages, pages:", imgs.length);
  flip.loadFromImages(imgs);

  // keyboard
  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft")  flip.flipPrev();
    if (e.key === "ArrowRight") flip.flipNext();
  });

  // resize responsif
  window.addEventListener("resize", () => {
    const vh2 = Math.max(window.innerHeight, document.documentElement.clientHeight);
    const h2 = Math.max(500, vh2 - 180);
    el.style.height = h2 + "px";
    // flip.update akan otomatis menyesuaikan karena size:'stretch'
  }, { passive: true });
})();
</script>

<style>
  body { overflow-x: hidden; }
  #flipbook { outline: none; }
  .form-dark .page { background:#0f172a; }
  #flipbook .page img { width:100%; height:100%; object-fit:contain; }
</style>

<%- include('layout-bottom') %>
