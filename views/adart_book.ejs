<%- include('layout-top', { title: 'AD/ART (Flipbook)', active: 'adart' }) %>

<div class="container py-4">
  <div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">AD/ART — Mode Flipbook</h1>
    <a href="/adart" class="btn btn-outline-light btn-sm ms-auto">Mode Scroll</a>
  </div>

  <div class="card border-0 form-dark">
    <div class="card-body">
      <div id="flipbook" class="mx-auto" style="width:920px;max-width:100%;height:600px"></div>
      <div id="errBox" class="text-danger small mt-3" style="display:none"></div>
      <p class="text-center small text-secondary mt-2">
        Sumber file: <code>/docs/adart.pdf</code>
      </p>
    </div>
  </div>
</div>

<!-- CSS flipbook -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/css/stpageflip.min.css">

<!-- PDF.js -->
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>
  // Worker harus eksplisit agar tidak diblokir CSP
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    "https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js";
</script>

<!-- STPageFlip (UMD) -->
<script src="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/js/stpageflip.min.js"></script>

<script>
(async function () {
  const errBox = document.getElementById("errBox");
  const showErr = (msg) => { errBox.style.display = "block"; errBox.textContent = msg; };

  const pdfUrl = "/docs/adart.pdf";

  // 1) Ambil dokumen PDF
  let pdf;
  try {
    pdf = await pdfjsLib.getDocument(pdfUrl).promise;
  } catch (e) {
    showErr("Gagal memuat PDF. Pastikan /docs/adart.pdf tersedia.");
    console.error(e);
    return;
  }

  // 2) Render semua halaman jadi dataURL gambar
  const images = [];
  try {
    for (let p = 1; p <= pdf.numPages; p++) {
      const page = await pdf.getPage(p);
      const base = page.getViewport({ scale: 1 });
      const targetH = 1000;                        // resolusi bagus
      const scale   = targetH / base.height;
      const vp      = page.getViewport({ scale });

      const canvas = document.createElement("canvas");
      canvas.width  = Math.ceil(vp.width);
      canvas.height = Math.ceil(vp.height);

      await page.render({ canvasContext: canvas.getContext("2d"), viewport: vp }).promise;
      images.push(canvas.toDataURL("image/jpeg", 0.92));
    }
  } catch (e) {
    showErr("Gagal merender halaman PDF.");
    console.error(e);
    return;
  }

  // 3) Inisialisasi flipbook (coba namespace St dulu, lalu fallback PageFlip)
  const FlipCtor = (window.St && window.St.PageFlip) || window.PageFlip;
  if (!FlipCtor) {
    showErr("Komponen flipbook tidak berhasil dimuat. Coba refresh (Ctrl+F5).");
    console.error("PageFlip global not found.");
    return;
  }

  const el = document.getElementById("flipbook");
  const flip = new FlipCtor(el, {
    width: 600,               // ukuran 1 halaman (bukan spread)
    height: 800,
    size: "stretch",
    showCover: true,
    mobileScrollSupport: true,
    maxShadowOpacity: 0.3,
    autoSize: true,
  });

  flip.loadFromImages(images);

  // Navigasi keyboard (opsional)
  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft")  flip.flipPrev();
    if (e.key === "ArrowRight") flip.flipNext();
  });
})();
</script>

<style>
  .form-dark .page { background:#0f172a; }
  #flipbook .page img { width:100%; height:100%; object-fit:contain; }
</style>

<%- include('layout-bottom') %>
