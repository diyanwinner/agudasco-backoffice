<%- include('layout-top', { title: 'AD/ART — Mode Flipbook', active: 'adart' }) %>

<div class="container py-4">
  <div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">AD/ART — Mode Flipbook</h1>
    <a href="/adart" class="btn btn-outline-light btn-sm ms-auto">Mode Scroll</a>
  </div>

  <div class="card border-0 form-dark">
    <div class="card-body">
      <div id="flipbook" class="mx-auto" style="width:920px;max-width:100%;height:600px;"></div>

      <div id="errBox" class="text-danger small mt-3" style="display:none;"></div>
      <p class="text-center small text-secondary mt-2">
        Sumber file: <code>/docs/adart.pdf</code>
      </p>
    </div>
  </div>
</div>

<!-- PageFlip CSS (lokal) -->
<link rel="stylesheet" href="/public/vendor/pageflip/stPageFlip.min.css">

<!-- PDF.js -->
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>
  // Worker wajib di-set eksplisit agar tidak diblokir CSP
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
</script>

<!-- PageFlip JS (lokal, browser build) -->
<script defer src="/public/vendor/pageflip/page-flip.browser.min.js"></script>

<script>
(async () => {
  const pdfUrl = '/docs/adart.pdf';
  const errBox = document.getElementById('errBox');
  const showErr = (m) => { errBox.style.display='block'; errBox.textContent = m; };
  const log = (...a) => console.log('[ADART]', ...a);

  try {
    // --- Render PDF → gambar ---
    log('mulai load PDF:', pdfUrl);
    const pdf = await pdfjsLib.getDocument(pdfUrl).promise;
    log('halaman PDF:', pdf.numPages);

    const imgs = [];
    for (let p = 1; p <= pdf.numPages; p++) {
      const page = await pdf.getPage(p);

      // target tinggi bagus; flipbook nanti stretch responsif
      const base = page.getViewport({ scale: 1 });
      const targetH = 1000; // px
      const scale = targetH / base.height;
      const vp = page.getViewport({ scale });

      const c = document.createElement('canvas');
      c.width  = Math.ceil(vp.width);
      c.height = Math.ceil(vp.height);
      await page.render({ canvasContext: c.getContext('2d'), viewport: vp }).promise;
      imgs.push(c.toDataURL('image/jpeg', 0.92));
    }
    log('sample image length:', imgs[0]?.length || 0);

    // --- Tunggu PageFlip ter-load (dari file lokal) ---
    let tries = 0;
    while (!(window.St && window.St.PageFlip) && tries < 40) { // ~2 detik
      await new Promise(r => setTimeout(r, 50));
      tries++;
    }
    if (!(window.St && window.St.PageFlip)) {
      throw new Error('Library PageFlip tidak ter-load. Coba refresh (Ctrl+F5).');
    }

    // --- Inisialisasi Flipbook ---
    const el = document.getElementById('flipbook');
    const flip = new St.PageFlip(el, {
      width: 600,            // ukuran 1 halaman (bukan spread)
      height: 800,
      size: 'stretch',
      showCover: true,
      mobileScrollSupport: true,
      maxShadowOpacity: 0.3,
      autoSize: true
    });

    flip.loadFromImages(imgs);

    // Navigasi keyboard (opsional)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft')  flip.flipPrev();
      if (e.key === 'ArrowRight') flip.flipNext();
    });

  } catch (e) {
    console.error(e);
    showErr(e?.message || 'Gagal memuat Flipbook.');
  }
})();
</script>

<style>
  /* Napas tipis + skin gelap selaras situs */
  .form-dark .stf__parent { padding: 6px 8px; background: transparent; }
  #flipbook { outline: none; }
  .form-dark .page { background:#0f172a; }
  #flipbook .page img { width:100%; height:100%; object-fit:contain; }
</style>

<%- include('layout-bottom') %>
