<%- include('layout-top', { title: 'AD/ART — Mode Flipbook', active: 'adart' }) %>

<div class="container py-4">
  <div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h5 mb-0">AD/ART — Mode Flipbook</h1>
    <a href="/adart" class="btn btn-outline-light btn-sm ms-auto">Mode Scroll</a>
  </div>

  <div class="card border-0 form-dark">
    <div class="card-body">
      <div id="flipWrap" class="mx-auto" style="max-width:1120px">
        <div id="flipbook" style="width:100%;height:640px"></div>
      </div>

      <div id="errBox" class="alert alert-danger mt-3 d-none small"></div>
      <p class="text-center small text-secondary mt-2">
        Sumber file: <code>/docs/adart.pdf</code>
      </p>
    </div>
  </div>
</div>

<link rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/css/stpageflip.min.css">

<!-- PDF.js -->
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
</script>

<!-- STPageFlip (primary CDN) -->
<script id="pf-primary"
  src="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/js/stpageflip.min.js"></script>

<script>
  // Loader tangguh: fallback ke unpkg bila primary gagal/lemot
  window.__loadPF = new Promise((resolve) => {
    function ready(){ resolve(true); }
    function fail(){ resolve(false); }
    function already(){ return (window.St && window.St.PageFlip) || window.PageFlip || window.pageflip; }

    if (already()) return ready();

    const primary = document.getElementById('pf-primary');
    primary.addEventListener('load', () => already() ? ready() : fail());
    primary.addEventListener('error', () => {
      const s = document.createElement('script');
      s.src = 'https://unpkg.com/st-pageflip@2.0.7/dist/js/stpageflip.min.js';
      s.onload = () => already() ? ready() : fail();
      s.onerror = fail;
      document.head.appendChild(s);
    });

    // kalau 1.5s belum siap, coba fallback juga
    setTimeout(() => {
      if (!already()) {
        const s = document.createElement('script');
        s.src = 'https://unpkg.com/st-pageflip@2.0.7/dist/js/stpageflip.min.js';
        s.onload = () => already() ? ready() : fail();
        s.onerror = fail;
        document.head.appendChild(s);
      }
    }, 1500);
  });

  // Tunggu objek global siap (maks 10 detik)
  function waitPageFlipReady(timeoutMs = 10000) {
    const start = performance.now();
    return new Promise((resolve, reject) => {
      (function poll(){
        const PF = (window.St && window.St.PageFlip) || window.PageFlip || window.pageflip || null;
        if (PF) return resolve(PF);
        if (performance.now() - start > timeoutMs) return reject(new Error('PageFlip belum siap'));
        requestAnimationFrame(poll);
      })();
    });
  }

  (async function init(){
    const PDF_URL = '/docs/adart.pdf';
    const flipEl  = document.getElementById('flipbook');
    const errBox  = document.getElementById('errBox');
    const showErr = (m)=>{ errBox.textContent=m; errBox.classList.remove('d-none'); };

    try {
      console.log('[ADART] mulai load PDF:', PDF_URL);
      const pdf = await pdfjsLib.getDocument(PDF_URL).promise;
      console.log('[ADART] halaman PDF:', pdf.numPages);

      const images = [];
      for (let p=1; p<=pdf.numPages; p++){
        const page = await pdf.getPage(p);
        const base = page.getViewport({ scale: 1 });
        const targetH = 1100;
        const scale   = targetH / base.height;
        const vp      = page.getViewport({ scale });

        const c = document.createElement('canvas');
        c.width  = Math.ceil(vp.width);
        c.height = Math.ceil(vp.height);
        await page.render({ canvasContext: c.getContext('2d'), viewport: vp }).promise;
        images.push(c.toDataURL('image/jpeg', 0.92));
      }
      console.log('[ADART] sample image length:', images[0]?.length || 0);

      // Pastikan script flipbook sudah ter-load (dengan fallback)
      await window.__loadPF;
      const PageFlip = await waitPageFlipReady();

      const flip = new PageFlip(flipEl, {
        width:  640,
        height: 920,
        size: 'stretch',
        showCover: true,
        useMouseEvents: true,
        maxShadowOpacity: .3,
        mobileScrollSupport: true,
        autoSize: true
      });

      flip.loadFromImages(images);

      // keyboard-only nav (tanpa tombol)
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft')  flip.flipPrev();
        if (e.key === 'ArrowRight') flip.flipNext();
      });

      // responsif
      const resize = () => {
        const w = Math.min(flipEl.clientWidth, 640);
        const h = Math.round(w * (920/640));
        flip.update({ width: w, height: h });
      };
      window.addEventListener('resize', resize, { passive: true });
      resize();

    } catch (e) {
      console.error(e);
      showErr('Library PageFlip tidak ter-load. Coba refresh (Ctrl+F5). Bila masih gagal, jaringan/CDN sedang bermasalah.');
    }
  })();
</script>

<style>
  #flipWrap { padding: 8px 0; }
  .form-dark .page { background:#0f172a; }
  #flipbook .page img { width:100%; height:100%; object-fit:contain; }
</style>

<%- include('layout-bottom') %>
