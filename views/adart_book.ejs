<%- include('layout-top', { title: 'AD/ART (Flipbook)', active: 'adart' }) %>

<div class="container py-4">
  <div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">AD/ART — Mode Flipbook</h1>
    <a href="/adart" class="btn btn-outline-light btn-sm ms-auto">Mode Scroll</a>
  </div>

  <div class="card border-0 form-dark">
    <div class="card-body">
      <div id="flipbook" class="mx-auto" style="width:920px;max-width:100%;height:600px"></div>
      <div id="errBox" class="text-danger small mt-3" style="display:none"></div>
      <p class="text-center small text-secondary mt-2">Sumber file: <code>/docs/adart.pdf</code></p>
    </div>
  </div>
</div>

<!-- CSS STPageFlip -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/css/stpageflip.min.css">

<!-- PDF.js (global) -->
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>
  // penting: workerSrc eksplisit agar tidak di-block CSP
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
</script>

<!-- STPageFlip UMD (NAMA FILE YANG BENAR) -->
<script src="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/js/stpageflip.min.js"></script>

<script>
(async () => {
  const pdfUrl = '/docs/adart.pdf';

  // render PDF -> images
  const pdf = await pdfjsLib.getDocument(pdfUrl).promise;
  const imgs = [];
  for (let p = 1; p <= pdf.numPages; p++) {
    const page = await pdf.getPage(p);
    const base = page.getViewport({ scale: 1 });
    const targetH = 1000;
    const scale   = targetH / base.height;
    const vp      = page.getViewport({ scale });

    const c = document.createElement('canvas');
    c.width  = Math.ceil(vp.width);
    c.height = Math.ceil(vp.height);
    await page.render({ canvasContext: c.getContext('2d'), viewport: vp }).promise;
    imgs.push(c.toDataURL('image/jpeg', 0.92));
  }

  // ambil ctor dari global UMD
  const FlipCtor = (window.St && window.St.PageFlip) ? window.St.PageFlip : null;
  if (!FlipCtor) {
    console.error('St.PageFlip tidak ditemukan');
    document.getElementById('errBox').style.display = 'block';
    document.getElementById('errBox').textContent =
      'Gagal memuat komponen flipbook. Coba refresh (Ctrl+F5).';
    return;
  }

  const el   = document.getElementById('flipbook');
  const flip = new FlipCtor(el, {
    width:  600,
    height: 800,
    size: 'stretch',
    showCover: true,
    mobileScrollSupport: true,
    maxShadowOpacity: 0.3,
    autoSize: true
  });

  flip.loadFromImages(imgs);

  // Navigasi keyboard
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  flip.flipPrev();
    if (e.key === 'ArrowRight') flip.flipNext();
  });

    // Responsif minimalis
    const fit = () => {
      const w = Math.min(980, el.clientWidth);
      const h = Math.round(w * (800/600)); // rasio 4:3-ish per halaman
      flip.update({ width: Math.round(w/1.6), height: Math.round(h/1.6) });
    };
    window.addEventListener('resize', fit, { passive: true });
    fit();

  } catch (e) {
    console.error(e);
    showErr('Gagal memuat flipbook. Pastikan /docs/adart.pdf ada dan refresh (Ctrl+F5).');
  }
</script>

<style>
  /* Dark skin + napas yang pas */
  .form-dark .page { background:#0f172a; }
  #flipbook .page img { width:100%; height:100%; object-fit:contain; }

  /* Sedikit kurangi ruang kosong di desktop lebar */
  @media (min-width:1200px){
    #flipbook{ max-width:980px; height:680px; }
  }
</style>

<%- include('layout-bottom') %>
