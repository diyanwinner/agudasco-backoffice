<%- include('layout-top', { title: 'AD/ART (Flipbook)', active: 'adart' }) %>

<div class="container py-4">
  <div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">AD/ART — Mode Flipbook</h1>
    <a href="/adart" class="btn btn-outline-light btn-sm ms-auto">Mode Scroll</a>
  </div>

  <div class="card border-0 form-dark">
    <div class="card-body">
      <div id="flipbook" class="mx-auto" style="width: 920px; max-width: 100%; height: 600px;"></div>

      <div class="d-flex justify-content-center gap-2 mt-3">
        <button id="prevBtn" class="btn btn-outline-light btn-sm">← Sebelumnya</button>
        <button id="nextBtn" class="btn btn-primary btn-sm">Berikutnya →</button>
      </div>

      <div id="errBox" class="text-danger small mt-3" style="display:none;"></div>
      <p class="text-center small text-secondary mt-2">
        Sumber file: <code>/docs/adart.pdf</code>
      </p>
    </div>
  </div>
</div>

<!-- CSS Flipbook -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/css/stpageflip.min.css">

<!-- PDF.js -->
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>
  // worker harus eksplisit agar lolos CSP
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
</script>

<script>
(async () => {
  const errBox = document.getElementById('errBox');
  const showErr = (msg) => { errBox.style.display = 'block'; errBox.textContent = msg; };

  // 1) Pastikan library flipbook (St.PageFlip) termuat — dengan fallback
  async function ensureFlipLib() {
    if (window.St && window.St.PageFlip) return;

    // Coba 1: st-pageflip (nama file yang benar: pageflip.min.js)
    try {
      await new Promise((res, rej) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/st-pageflip@2.0.7/dist/js/pageflip.min.js';
        s.onload = res; s.onerror = () => rej(new Error('cdn st-pageflip gagal'));
        document.head.appendChild(s);
      });
    } catch (_) {
      // Coba 2: page-flip (build browser)
      await new Promise((res, rej) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js';
        s.onload = res; s.onerror = rej;
        document.head.appendChild(s);
      }).catch((e) => { throw new Error('Gagal memuat library flipbook dari semua CDN'); });
    }

    if (!(window.St && window.St.PageFlip)) {
      throw new Error('Flipbook library tidak tersedia (St.PageFlip belum terdefinisi).');
    }
  }

  try {
    await ensureFlipLib();
  } catch (e) {
    showErr(e.message);
    return;
  }

  // 2) Ambil PDF
  const pdfUrl = '/docs/adart.pdf';
  let pdf;
  try {
    pdf = await pdfjsLib.getDocument(pdfUrl).promise;
  } catch (e) {
    showErr('Gagal memuat PDF. Pastikan /docs/adart.pdf ada dan dapat diakses.');
    return;
  }

  // 3) Render semua halaman jadi dataURL
  const pageImages = [];
  try {
    for (let p = 1; p <= pdf.numPages; p++) {
      const page = await pdf.getPage(p);
      const targetH = 1000;
      const vp0 = page.getViewport({ scale: 1 });
      const scale = targetH / vp0.height;
      const vp = page.getViewport({ scale });

      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = Math.ceil(vp.width);
      canvas.height = Math.ceil(vp.height);
      await page.render({ canvasContext: ctx, viewport: vp }).promise;
      pageImages.push(canvas.toDataURL('image/jpeg', 0.92));
    }
  } catch (e) {
    showErr('Gagal merender halaman PDF.');
    return;
  }

  // 4) Inisialisasi flipbook
  const el = document.getElementById('flipbook');
  const flip = new St.PageFlip(el, {
    width: 600,          // ukuran 1 halaman (bukan spread)
    height: 800,
    size: 'stretch',
    showCover: true,
    useMouseEvents: true,
    maxShadowOpacity: 0.3,
    mobileScrollSupport: true,
    autoSize: true,
  });

  flip.loadFromImages(pageImages);

  // Navigasi
  document.getElementById('prevBtn').addEventListener('click', () => flip.flipPrev());
  document.getElementById('nextBtn').addEventListener('click', () => flip.flipNext());

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  flip.flipPrev();
    if (e.key === 'ArrowRight') flip.flipNext();
  });
})();
</script>

<style>
  .form-dark .page { background:#0f172a; }
  #flipbook .page img { width:100%; height:100%; object-fit:contain; }
</style>

<%- include('layout-bottom') %>
