<section class="section">
  <div class="section-head">
    <h2>Anggota</h2>
  </div>

  <% if (!members.length) { %>
    <p class="muted">Belum ada data anggota.</p>
  <% } else { %>
    <div class="grid cards">
      <% members.forEach(m => { %>
        <a class="card rowlink" href="/anggota/<%= m.id %>">
          <img src="<%= m.avatar || 'https://via.placeholder.com/960x400?text=Anggota' %>" alt="<%= m.name %>">
          <div class="pad">
            <h3><%= m.name %></h3>
            <p class="meta">Bergabung: <%= new Date(m.created_at).toLocaleDateString('id-ID') %></p>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>
