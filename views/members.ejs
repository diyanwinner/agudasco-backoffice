<div class="page-wrap">
  <div class="container">
    
    <div class="text-center mb-5" data-aos="fade-down">
      <h1 class="display-5 fw-bold text-white">Anggota Organisasi</h1>
      
      <div class="d-inline-flex align-items-center gap-2 mt-2 px-4 py-2 rounded-pill" 
           style="background: rgba(37, 99, 235, 0.1); border: 1px solid rgba(37, 99, 235, 0.3);">
        <span class="fs-5">👥</span>
        <span class="fw-bold text-white"><%= members.length %></span>
        <span class="text-info">Anggota Terdaftar</span>
      </div>
    </div>

    <% if (typeof user !== 'undefined' && user) { %>

      <div class="row justify-content-center mb-5" data-aos="fade-up">
        <div class="col-md-6">
          <input type="text" id="searchMember" class="form-control form-control-lg bg-dark text-white border-secondary" 
                 placeholder="Cari nama anggota..." 
                 style="border-radius: 50px; padding: 15px 30px; backdrop-filter: blur(5px); background: rgba(15, 23, 42, 0.6) !important;">
        </div>
      </div>

      <div class="custom-grid-container" id="memberGrid">
        <% members.forEach(m => { %>
          <a href="/anggota/<%= m.id %>" class="grid-item member-item text-decoration-none" data-aos="zoom-in">
            <div class="card-elegant">
              <div class="avatar-wrap">
                <% if(m.avatar){ %>
                  <img src="<%= m.avatar %>" alt="<%= m.name %>" loading="lazy">
                <% } else { %>
                  <div class="no-avatar"><%= m.name.charAt(0) %></div>
                <% } %>
              </div>
              <h3 class="member-name name-text"><%= m.name %></h3>
              <span class="member-badge">Lihat Profil →</span>
            </div>
          </a>
        <% }) %>
      </div>

      <div id="noResults" class="text-center text-secondary mt-5" style="display:none;">
        <div style="font-size: 3rem;">🔍</div>
        <p class="fs-5 mt-2">Anggota tidak ditemukan.</p>
      </div>

    <% } else { %>

      <div class="locked-state" data-aos="zoom-in">
        
        <div class="lock-icon-wrap"><div class="lock-icon">🔒</div></div>
        
        <h2 class="text-white fw-bold mb-2">Halaman Khusus Pengurus</h2>
        
        <p class="text-secondary mb-5" style="max-width: 500px; margin: 0 auto; line-height: 1.5;">
          Data anggota bersifat rahasia. Silakan login sebagai pengurus untuk mengakses informasi lengkap.
        </p>
        
        <a href="/login" class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-lg fw-bold">
          Masuk ke Sistem
        </a>
        
      </div>

    <% } %>

  </div>
</div>

<style>
  /* ... (CSS LAIN TETAP SAMA) ... */
  .custom-grid-container { display: grid; grid-template-columns: 1fr; gap: 20px; padding-bottom: 50px; }
  @media (min-width: 600px) { .custom-grid-container { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 992px) { .custom-grid-container { grid-template-columns: repeat(3, 1fr); } }

  .card-elegant { background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 30px 20px; text-align: center; transition: 0.3s; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .card-elegant:hover { background: rgba(30, 41, 59, 0.8); border-color: #3b82f6; transform: translateY(-5px); }
  .avatar-wrap { width: 100px; height: 100px; border-radius: 50%; overflow: hidden; margin-bottom: 15px; border: 3px solid rgba(255,255,255,0.1); background: #0f172a; }
  .avatar-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .no-avatar { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #334155; color: #cbd5e1; font-weight: bold; font-size: 2rem; }
  .member-name { color: white; font-size: 1.1rem; font-weight: 700; margin-bottom: 10px; text-transform: capitalize; }
  .member-badge { background: rgba(59, 130, 246, 0.1); color: #60a5fa; padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; border: 1px solid rgba(59, 130, 246, 0.2); transition: 0.3s; }
  .card-elegant:hover .member-badge { background: #2563eb; color: white; }

  /* LOCKED STATE STYLE */
  .locked-state {
    background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.05);
    border-radius: 24px; padding: 60px 20px; text-align: center; margin: 40px auto; max-width: 600px;
  }
  .lock-icon-wrap {
    width: 80px; height: 80px; margin: 0 auto 20px;
    background: rgba(37, 99, 235, 0.1); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .lock-icon { font-size: 2.5rem; }
</style>

<% if (typeof user !== 'undefined' && user) { %>
<script>
  const searchInput = document.getElementById('searchMember');
  const noRes = document.getElementById('noResults');
  if(searchInput){
    searchInput.addEventListener('keyup', function(e){
      const term = e.target.value.toLowerCase();
      const items = document.querySelectorAll('.grid-item');
      let count = 0;
      items.forEach(item => {
        const name = item.querySelector('.name-text').textContent.toLowerCase();
        if(name.includes(term)){ item.style.display = ''; count++; } 
        else { item.style.display = 'none'; }
      });
      noRes.style.display = (count === 0) ? 'block' : 'none';
    });
  }
</script>
<% } %>
