<div class="container py-6" style="max-width:900px">
  <a href="/articles" style="text-decoration:none;color:#9ab">← Kembali</a>
  <h1 class="mt-2 mb-3"><%= article.title %></h1>

  <% if (article.image) { %>
    <img src="<%= article.image %>" alt="<%= article.title %>" style="width:100%;max-height:380px;object-fit:cover;border-radius:12px;margin-bottom:16px">
  <% } %>

  <div class="content" style="line-height:1.6;white-space:pre-wrap">
    <%= article.content || '' %>
  </div>
</div>
