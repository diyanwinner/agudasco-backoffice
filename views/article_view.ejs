<% layout('layout', {active:'artikel'}) %>
<article class="card">
  <img src="<%= article.image||'https://via.placeholder.com/960x400?text=Artikel' %>" alt="<%= article.title %>"/>
  <div class="pad">
    <h1><%= article.title %></h1>
    <p class="meta">Dipublikasikan: <%= new Date(article.created_at).toLocaleString('id-ID') %></p>
    <div><%- (article.content||'').replace(/\n/g,'<br/>') %></div>
  </div>
</article>
