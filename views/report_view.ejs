<h1 style="margin:0 0 12px;">Laporan Keuangan</h1>

<style>
  .toolbar {
    display:flex; gap:8px; align-items:center;
    background:#0b1424; border:1px solid #1f2937; border-radius:10px;
    padding:10px 12px; margin:8px 0 14px;
  }
  .toolbar .hint { color:#9ca3af; font-size:12px; margin-left:auto; }
  .btn {
    display:inline-block; padding:8px 12px; border-radius:8px; font-weight:700;
    text-decoration:none; border:0; cursor:pointer;
  }
  .btn.success { background:#22c55e; color:#032010; }
  .btn.secondary { background:#334155; color:#e5e7eb; }
  .viewer {
    height:80vh; width:100%;
    background:#0c1424; border:1px solid #1f2937; border-radius:12px;
    overflow:hidden;
  }
  .viewer iframe { width:100%; height:100%; border:0; }
</style>

<div class="toolbar">
  <a href="/file/<%= report.id %>?download=1" class="btn success">Download</a>
  <a href="/laporan" class="btn secondary">Kembali</a>
  <span class="hint">Pratinjau dokumen</span>
</div>

<div class="viewer">
  <iframe src="<%= pdfUrl %>" allow="fullscreen"></iframe>
</div>
