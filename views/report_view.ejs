<!-- views/report_view.ejs -->
<h1>Laporan Keuangan</h1>

<div class="card">
  <div class="flex-row" style="margin-bottom:10px">
    <div class="muted">Pratinjau dokumen</div>
    <div>
      <a class="btn" href="<%= report.file %>" target="_blank" rel="noopener">Download</a>
      <a class="btn small" href="/laporan" style="margin-left:8px">Kembali</a>
    </div>
  </div>

  <div class="viewer">
    <% if (isPDF) { %>
      <!-- PDF preview native -->
      <embed
        src="<%= report.file %>#toolbar=1&navpanes=0&scrollbar=1"
        type="application/pdf"
      />
    <% } else { %>
      <!-- Office files via Google Viewer -->
      <iframe src="<%= googleViewer %>" loading="lazy"></iframe>
    <% } %>
  </div>
</div>

<style>
  .viewer{
    height:70vh;
    background:#0a0f1a;
    border:1px solid var(--line);
    border-radius:12px;
    overflow:hidden;
  }
  .viewer iframe,
  .viewer embed{
    width:100%;
    height:100%;
    border:0;
    display:block;
  }
</style>
