<div class="card">
  <img src="<%= report.cover||'https://via.placeholder.com/960x400?text=Laporan' %>" alt="<%= report.title %>"/>
  <div class="pad">
    <h1><%= report.title %></h1>
    <p class="meta">Diunggah: <%= new Date(report.created_at).toLocaleString('id-ID') %></p>
    <% if(report.pdf_url){ %>
      <a class="btn red" href="<%= report.pdf_url %>" target="_blank" rel="noopener">Unduh PDF</a>
    <% } else { %>
      <p class="meta">Belum ada file PDF.</p>
    <% } %>
  </div>
</div>
